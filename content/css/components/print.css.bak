/* =======================================================
   BASE
======================================================= */

html,
body {
    margin: 0;
    padding: 0;
    color: #222;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 10pt;
}

/* =======================================================
   HEADER
======================================================= */

.print-header {
    display: flex;
    justify-content: space-between;
    align-items: center;

    height: 22mm;
    padding: 4mm 8mm;
    box-sizing: border-box;
    border-bottom: 3px solid #444;


}

.header-logo {
    width: 40px;
    height: 40px;
}

.temp-icon-grid img {
    width: 70px;
    height: 70px;
}

.badge-icon {
    width: 100px;
    height: 100px;
}


.ods-icon {
    width: 60px;
    height: 60px;
}




.header-center {
    font-size: 18pt;
    font-weight: bold;
    text-align: center;
}


/* =======================================================
   LAYOUT PRINCIPAL
======================================================= */

.print-page {
    display: flex;
    gap: 8mm;

    padding-left: 8mm;
    padding-right: 8mm;
    padding-top: 6mm;
    align-items: flex-start;
}

.print-sidebar {
    width: 20%;
    flex-shrink: 0;
}

.print-content {
    width: 80%;
    min-width: 0;
}

/* =======================================================
   SIDEBAR
======================================================= */

.sidebar-box {
    border: px dashed #a50ee6;
    background: #f7f7f7;
  /* This rounds all four corners equally */
    border-radius: 25px; 
    padding: 4mm;
    font-size: 10pt;
}

.sidebar-section {
    margin-bottom: 5mm;
}

.sidebar-section:last-child {
    margin-bottom: 0;
}

.sidebar-section h3 {
    margin: 0 0 2mm 0;
    padding-bottom: 1mm;

    font-size: 11pt;

    border-bottom: 2px solid #999;

    text-transform: uppercase;

}

.meta-item {
    display: flex;
    align-items: center;

    padding: 1.5mm 0;

    border-bottom: 1px solid #ddd;
}

.meta-item:last-child {
    border-bottom: none;
}

.sidebar-box ul {
    margin: 0;
    padding-left: 5mm;
}

.sidebar-box li {
    margin-bottom: 1mm;
}

/* =======================================================
   CONTENIDO
======================================================= */

.print-content h1 {
    margin-top: 0;
    margin-bottom: 18px;

    font-size: 24pt;
    font-weight: bold;

    text-align: center;

    padding-bottom: 8px;
}


.activity-summary {
    background: #f3f3f3;
    border-left: 5px solid #666;

    padding: 3mm;
    margin-bottom: 5mm;

    font-style: italic;
}

.print-section {
    margin-bottom: 5mm;
}

.print-section h2 {
    background: #ddd;
    border-left: 5px solid #666;

    padding: 2mm 3mm;
    margin-bottom: 3mm;

    font-size: 14pt;
}

.print-section a,
.print-section li,
.print-section p {
    overflow-wrap: break-word;
    word-break: break-word;
    line-height: 1.4;
}

/* =======================================================
   IMÁGENES
======================================================= */

.print-content img {
    max-width: 90%;
    height: auto;

    display: block;
    margin: 6mm auto;

    page-break-inside: avoid;
    break-inside: avoid;
}


.print-content figure {
    break-inside: avoid;
}


/* =======================================================
   FOOTER
======================================================= */

.print-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;

    border-top: #161514;
    border-top-style: double;
    font-size: 9pt;
    box-sizing: border-box;

    height: 22mm;
    padding: 4mm 8mm;


}

.print-footer::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    border-top: 3px solid #555;
}

/* =======================================================
   EVITAR CORTES FEOS
======================================================= */

.print-section,
.sidebar-box,
.print-content img {
    break-inside: avoid;
    page-break-inside: avoid;
}

/* =======================================================
   IMPRESIÓN
======================================================= */

@page {
    size: A4 portrait;

    margin-top: 15mm;
    margin-bottom: 18mm;
    margin-left: 15mm;
    margin-right: 15mm;
}

@media print {

```
html,
body {
    margin: 0;
    padding: 0;
}

.print-footer{
    position: fixed;
    bottom: 8mm;
    left: 6mm;
    right: 6mm;

    height: 10mm;
border-top: 3px solid #555;
    background: white;
    z-index: 1000;
}

.header-line {
    display: none;
}

.print-page {

    margin-top: 0mm;
    margin-bottom: 20mm;

    display: flex;
    align-items: flex-start;
    gap: 20px;
}

.print-sidebar {
    width: 20%;
    flex-shrink: 0;
}

.print-content {
    width: 80%;

}






.print-section,
.sidebar-section,
img {
    break-inside: avoid;
    page-break-inside: avoid;
}

.print-content img {
    max-width: 100%;
    height: auto;
}
```

}




.meta-item{
    margin-bottom:4mm;
}

.meta-label{
    font-size:8pt;
    font-weight:bold;
    color:#666;
    text-transform:uppercase;
}

.meta-value{
    font-size:10pt;
}


.print-content img{
    max-width:100%;
    border:1px solid #bbb;
    padding:2mm;
    background:white;
}


/* =======================================================
   RECURSOS
======================================================= */

.resource-list {
    display: flex;
    flex-direction: column;
    gap: 4mm;
}

.resource-card {
    border: 1px solid #bbb;
    background: #f8f8f8;
    padding: 3mm;
}

.resource-title {
    font-weight: bold;
    margin-bottom: 1mm;
}

.resource-url {
    font-size: 8pt;
    word-break: break-word;
}


