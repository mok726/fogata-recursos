---
title: Fogata de Recursos
layout: layouts/base.njk
permalink: /

# Tienen que ir en el front matter: un {% set %} en el cuerpo
# no le llega al layout (por eso antes home.css nunca cargaba).
styles:
  - /css/pages/home.css

fonts:
  - https://fonts.googleapis.com/css2?family=Rubik+Dirt&family=Roboto+Slab:wght@600;800&display=swap

# Palabras que aparecen en títulos/descripciones, así la
# búsqueda de /activities/?search=... devuelve resultados.
temas:
  - agua
  - reciclaje
  - energía
  - bosques
  - biodiversidad
  - clima
  - océano
  - alimentos
  - suelo
  - polinizadores
  - juego
  - salud
  - plástico
  - desastres
  - comunidad
  - experimento

populares:
  - agua
  - reciclaje
  - juego
  - energía
---

<div class="home" data-pagefind-ignore="all">

<section class="home-hero">

  <div class="home-hero-art">
    <img
      src="{{ '/imagenes/favicon.png' | thumb('hero') | url }}"
      width="720" height="1037"
      fetchpriority="high"
      alt="Fogata con forma de flor de lis">
  </div>

  <div class="home-hero-content">

    <h1>
      <span class="home-hero-word">Fogata</span>
      <span class="home-hero-de">de</span>
      <span class="home-hero-word">Recursos</span>
    </h1>

    <p>
      Biblioteca abierta de actividades scouts, recursos educativos
      y propuestas pedagógicas.
    </p>

    <form
      class="home-search"
      role="search"
      action="{{ '/activities/' | url }}"
      method="get">

      <span class="material-symbols-outlined" aria-hidden="true">search</span>

      <input
        id="search-input"
        name="search"
        type="search"
        autocomplete="off"
        aria-label="Buscar en el sitio"
        placeholder="Buscar: agua, reciclaje, juego, ODS 13…">

      <button type="submit">Buscar</button>

      <div id="search-results" class="home-search-results" hidden></div>

    </form>

    <p class="home-popular">
      Populares:
      {% for tema in populares %}
        <a href="{{ ('/activities/?search=' + tema) | url }}">{{ tema }}</a>
      {% endfor %}
    </p>

  </div>

  <svg class="home-hero-hills" viewBox="0 0 1200 140" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 140V90l80-40 70 30 90-55 110 50 80-30 120 45 100-60 120 55 90-35 110 40 100-50 130 60v40z" fill="#c9c3a6" opacity=".55"/>
    <path d="M0 140v-30l120-25 140 30 160-35 150 30 140-25 160 30 150-20 180 25v20z" fill="#b5b08f" opacity=".6"/>
    <path d="M60 60l-20 36h10l-16 28h10l-13 16h58l-13-16h10l-16-28h10z" fill="#8f9a7c"/>
    <path d="M1100 30l-26 46h13l-20 36h13l-17 28h74l-17-28h13l-20-36h13z" fill="#8f9a7c"/>
    <path d="M1160 70l-16 30h8l-13 22h8l-10 18h46l-10-18h8l-13-22h8z" fill="#8f9a7c"/>
  </svg>

</section>


<ul class="home-stats">
  <li><b>{{ collections.activities | length }}</b> actividades</li>
  <li><b>{{ badges | length }}</b> insignias</li>
  <li><b>{{ allSdgs | length }}</b> ODS</li>
  <li><b>{{ ageGroups | length }}</b> ramas</li>
</ul>


<section class="home-section">

  <h2>¿Por dónde empezás?</h2>

  <div class="home-paths">

    <a class="home-path" href="{{ '/activities/' | url }}">
      <span class="material-symbols-outlined" aria-hidden="true">explore</span>
      <h3>Actividades</h3>
      <p>Juegos, talleres y dinámicas</p>
    </a>

    <a class="home-path" href="{{ '/badges/' | url }}">
      <span class="material-symbols-outlined" aria-hidden="true">military_tech</span>
      <h3>Insignias</h3>
      <p>Progresión por especialidad</p>
    </a>

    <a class="home-path" href="{{ '/ods/' | url }}">
      <span class="material-symbols-outlined" aria-hidden="true">public</span>
      <h3>ODS</h3>
      <p>La Agenda 2030 en acción</p>
    </a>

    <a class="home-path" href="{{ '/edades/' | url }}">
      <span class="material-symbols-outlined" aria-hidden="true">groups</span>
      <h3>Edades</h3>
      <p>Propuestas por rama scout</p>
    </a>

  </div>

</section>


<section class="home-section">

  <div class="home-section-header">

    <div>
      <h2>Actividades destacadas</h2>
      <p>Algunas de las últimas actividades incorporadas.</p>
    </div>

    <a class="home-more" href="{{ '/activities/' | url }}">
      Ver las {{ collections.activities | length }} →
    </a>

  </div>

  <div class="grid">

    {% for activityItem in collections.activitiesSorted %}
      {% if loop.index <= 6 %}
        {% set item = activityItem.data %}
        {% set activityUrl = activityItem.url %}
        {% include "components/activity-card.njk" %}
      {% endif %}
    {% endfor %}

  </div>

</section>


<section class="home-section">

  <h2>Temas frecuentes</h2>

  <div class="home-topics">
    {% for tema in temas %}
      <a href="{{ ('/activities/?search=' + tema) | url }}">{{ tema }}</a>
    {% endfor %}
  </div>

</section>


<section class="home-section home-cta">

  <div>
    <h2>¿Tenés una actividad que funciona?</h2>
    <p>Sumala a la fogata y que la usen otros grupos.</p>
  </div>

  <a href="{{ '/colaborar/' | url }}">Colaborar</a>

</section>

</div>


<script type="module">

import * as pagefind from "{{ '/pagefind/pagefind.js' | url }}";

await pagefind.options({ baseUrl: "{{ '/' | url }}" });

const input = document.getElementById("search-input");
const resultsContainer = document.getElementById("search-results");

const escapeHtml = s => String(s).replace(/[&<>"]/g, c =>
  ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));

let lastQuery = "";

input.addEventListener("input", async () => {

  const query = input.value.trim();
  lastQuery = query;

  if (query.length < 2) {
    resultsContainer.hidden = true;
    resultsContainer.innerHTML = "";
    return;
  }

  const search = await pagefind.debouncedSearch(query);

  // Llegó una búsqueda más nueva mientras esperábamos.
  if (search === null || query !== lastQuery) return;

  const results = await Promise.all(
    search.results.slice(0, 6).map(r => r.data())
  );

  resultsContainer.innerHTML = results.length
    ? results.map(r => `
        <a class="home-search-result" href="${r.url}">
          <strong>${escapeHtml(r.meta.title || "Sin título")}</strong>
          <span>${r.excerpt || ""}</span>
        </a>`).join("")
      + `<button type="submit" class="home-search-all">Ver todas las actividades con «${escapeHtml(query)}»</button>`
    : `<p class="home-search-empty">Sin resultados para «${escapeHtml(query)}».</p>`;

  resultsContainer.hidden = false;

});

document.addEventListener("click", e => {
  if (!e.target.closest(".home-search")) resultsContainer.hidden = true;
});

input.addEventListener("keydown", e => {
  if (e.key === "Escape") resultsContainer.hidden = true;
});

</script>
