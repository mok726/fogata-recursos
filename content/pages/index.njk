---
title: Fogata de Recursos
layout: layouts/base.njk
permalink: /

# Tienen que ir en el front matter: un {% set %} en el cuerpo
# no le llega al layout (por eso antes home.css nunca cargaba).
styles:
  - /css/pages/home.css

fonts:
  - https://fonts.googleapis.com/css2?family=Rubik+Dirt&family=Roboto+Slab:wght@600;800&display=swap

# Palabras que aparecen en títulos/descripciones, así la
# búsqueda de /activities/?search=... devuelve resultados.
temas:
  - agua
  - reciclaje
  - energía
  - bosques
  - biodiversidad
  - clima
  - océano
  - alimentos
  - suelo
  - polinizadores
  - juego
  - salud
  - plástico
  - desastres
  - comunidad
  - experimento

populares:
  - agua
  - reciclaje
  - juego
  - energía
---

<div class="home" data-pagefind-ignore="all">

<section class="home-hero">

  <div class="home-hero-art">
    <img
      src="{{ '/imagenes/favicon.png' | thumb('hero') | url }}"
      width="720" height="1037"
      fetchpriority="high"
      alt="Fogata con forma de flor de lis">
  </div>

  <div class="home-hero-content">

    <h1>
      <span class="home-hero-word">Fogata</span>
      <span class="home-hero-de">de</span>
      <span class="home-hero-word">Recursos</span>
    </h1>

    <p>
      Biblioteca abierta de actividades scouts, recursos educativos
      y propuestas pedagógicas.
    </p>

    <form
      class="home-search"
      role="search"
      action="{{ '/activities/' | url }}"
      method="get">

      <span class="material-symbols-outlined" aria-hidden="true">search</span>

      <input
        id="search-input"
        name="search"
        type="search"
        autocomplete="off"
        aria-label="Buscar en el sitio"
        placeholder="Buscar: agua, reciclaje, juego, ODS 13…">

      <button type="submit">Buscar</button>

      <div id="search-results" class="home-search-results" hidden></div>

    </form>

    <p class="home-popular">
      Populares:
      {% for tema in populares %}
        <a href="{{ ('/activities/?search=' + tema) | url }}">{{ tema }}</a>
      {% endfor %}
    </p>

  </div>


</section>


<ul class="home-stats">
  <li><b>{{ collections.activities | length }}</b> actividades</li>
  <li><b>{{ badges | length }}</b> insignias</li>
  <li><b>{{ allSdgs | length }}</b> ODS</li>
  <li><b>{{ ageGroups | length }}</b> ramas</li>
</ul>


{# Actividad del día: se renderiza la del día del build y el
   script la cambia si en el navegador ya es otro día (por si el
   build diario no corrió). Rotación en lib/actividad-del-dia.js. #}
{% set diasHoy = collections.activitiesDaily | actividadesDelDia(3) %}
{% if diasHoy[0].item %}
<section class="home-section home-daily" id="actividad-del-dia">

  {# Se renderizan hoy y los 2 días siguientes; el script muestra la
     que corresponde a la fecha del navegador (por si el build diario
     no corrió). Sin JS queda visible la del día del build.
     Izquierda: la portada de la card del sitio (tipo, duración,
     edades, ramas). Derecha: título, descripción, ODS e insignia. #}
  {% for d in diasHoy %}
    {% set item = d.item.data %}
    {% set activityUrl = d.item.url %}
    <div class="home-daily-dia" data-fecha="{{ d.fecha }}" {% if not loop.first %}hidden{% endif %}>

      {% set layout = "compact" %}
      {% include "components/activity-card.njk" %}

      <div class="home-daily-body">

        {# Kicker e insignias en el mismo renglón. Hasta 2 insignias; si
           hay más, la primera y un círculo «+N» (como en las cards). #}
        <div class="home-daily-head">
          <a class="home-daily-kicker" href="{{ activityUrl | url }}" tabindex="-1">
            <span class="material-symbols-outlined" aria-hidden="true">local_fire_department</span>
            Actividad del día
          </a>
          {% if item.activity_badges and item.activity_badges.length %}
            {% set totalBadges = item.activity_badges.length %}
            {% set shownBadges = totalBadges if totalBadges <= 2 else 1 %}
            <div class="home-daily-badges">
              {% for rawBadge in item.activity_badges.slice(0, shownBadges) %}
                {% set badgeId = rawBadge.id if rawBadge.id else (rawBadge | slugify) %}
                <a href="{{ (badgeId | badgeHref(badges)) | url }}">
                  <img class="badge-icon" loading="lazy" decoding="async"
                    src="{{ (badgeId | badgeLogo(badges)) | url }}"
                    alt="Insignia" title="{{ rawBadge.name if rawBadge.name else (rawBadge | smartTitle) }}">
                </a>
              {% endfor %}
              {% if totalBadges > shownBadges %}
                <a class="home-daily-more" href="{{ activityUrl | url }}"
                  title="{{ totalBadges - shownBadges }} insignias más">+{{ totalBadges - shownBadges }}</a>
              {% endif %}
            </div>
          {% endif %}
        </div>

        <h2 class="home-daily-title">
          <a href="{{ activityUrl | url }}">{{ item.title | smartTitle }}</a>
        </h2>

        <a class="home-daily-desc" href="{{ activityUrl | url }}" tabindex="-1">{{ item.description or item.summary }}</a>

        <div class="home-daily-foot">
          <a class="home-more" href="{{ activityUrl | url }}">Ver la actividad →</a>
          {% if item.sdgs and item.sdgs.length %}
            <div class="home-daily-sdgs">
              {% for sdg in item.sdgs.slice(0, 4) %}
                <a href="{{ ('/ods/' + sdg + '/') | url }}">
                  <img class="sdg-icon" loading="lazy" decoding="async"
                    src="{{ ('/imagenes/ods/ods-' + sdg + '.png') | url }}"
                    alt="ODS {{ sdg }}" title="ODS {{ sdg }}">
                </a>
              {% endfor %}
            </div>
          {% endif %}
        </div>

      </div>
    </div>
  {% endfor %}
  {% set layout = "" %}

  <script>
  (function () {
    try {
      var hoy = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Argentina/Buenos_Aires',
        year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
      var dias = document.querySelectorAll('#actividad-del-dia .home-daily-dia');
      var elegido = null;
      dias.forEach(function (el) { if (el.getAttribute('data-fecha') === hoy) elegido = el; });
      if (!elegido) return;
      dias.forEach(function (el) { el.hidden = el !== elegido; });
    } catch (e) {}
  })();
  </script>

</section>
{% endif %}


<section class="home-section">

  <h2>¿Por dónde empezás?</h2>

  <div class="home-paths">

    <a class="home-path" href="{{ '/activities/' | url }}">
      <span class="material-symbols-outlined" aria-hidden="true">explore</span>
      <h3>Actividades</h3>
      <p>Juegos, talleres y dinámicas</p>
    </a>

    <a class="home-path" href="{{ '/badges/' | url }}">
      <span class="material-symbols-outlined" aria-hidden="true">military_tech</span>
      <h3>Insignias</h3>
      <p>Progresión por especialidad</p>
    </a>

    <a class="home-path" href="{{ '/ods/' | url }}">
      <span class="material-symbols-outlined" aria-hidden="true">public</span>
      <h3>ODS</h3>
      <p>La Agenda 2030 en acción</p>
    </a>

    <a class="home-path" href="{{ '/edades/' | url }}">
      <span class="material-symbols-outlined" aria-hidden="true">groups</span>
      <h3>Edades</h3>
      <p>Propuestas por rama scout</p>
    </a>

  </div>

</section>


<section class="home-section">

  <div class="home-section-header">

    <div>
      <h2>Actividades destacadas</h2>
      <p>Las últimas incorporadas y las actividades de los días anteriores.</p>
    </div>

    <a class="home-more" href="{{ '/activities/' | url }}">
      Ver las {{ collections.activities | length }} →
    </a>

  </div>

  <div class="grid">

    {% for activityItem in collections.activitiesRecent | destacadas(collections.activitiesDaily) %}
        {% set item = activityItem.data %}
        {% set activityUrl = activityItem.url %}
        {% include "components/activity-card.njk" %}
    {% endfor %}

  </div>

</section>


<section class="home-section">

  <h2>Temas frecuentes</h2>

  <div class="home-topics">
    {% for tema in temas %}
      <a href="{{ ('/activities/?search=' + tema) | url }}">{{ tema }}</a>
    {% endfor %}
  </div>

</section>


<section class="home-section home-cta">

  <div>
    <h2>¿Tenés una actividad que funciona?</h2>
    <p>Sumala a la fogata y que la usen otros grupos.</p>
  </div>

  <a href="{{ '/colaborar/' | url }}">Colaborar</a>

</section>

</div>


<script type="module">

import * as pagefind from "{{ '/pagefind/pagefind.js' | url }}";

await pagefind.options({ baseUrl: "{{ '/' | url }}" });

const input = document.getElementById("search-input");
const resultsContainer = document.getElementById("search-results");

const escapeHtml = s => String(s).replace(/[&<>"]/g, c =>
  ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));

let lastQuery = "";

input.addEventListener("input", async () => {

  const query = input.value.trim();
  lastQuery = query;

  if (query.length < 2) {
    resultsContainer.hidden = true;
    resultsContainer.innerHTML = "";
    return;
  }

  const search = await pagefind.debouncedSearch(query);

  // Llegó una búsqueda más nueva mientras esperábamos.
  if (search === null || query !== lastQuery) return;

  const results = await Promise.all(
    search.results.slice(0, 6).map(r => r.data())
  );

  resultsContainer.innerHTML = results.length
    ? results.map(r => `
        <a class="home-search-result" href="${r.url}">
          <strong>${escapeHtml(r.meta.title || "Sin título")}</strong>
          <span>${r.excerpt || ""}</span>
        </a>`).join("")
      + `<button type="submit" class="home-search-all">Ver todas las actividades con «${escapeHtml(query)}»</button>`
    : `<p class="home-search-empty">Sin resultados para «${escapeHtml(query)}».</p>`;

  resultsContainer.hidden = false;

});

document.addEventListener("click", e => {
  if (!e.target.closest(".home-search")) resultsContainer.hidden = true;
});

input.addEventListener("keydown", e => {
  if (e.key === "Escape") resultsContainer.hidden = true;
});

</script>
