---
layout: layouts/base.njk
title: Edades
---

<h1>Grupos Etarios</h1>

<div class="grid">

  {% for age in ageGroups %}

<a href="{{ ('/edades/' + age.id + '/') | url }}">
      <div class="card">

        <div class="card-content">

          <h2>{{ age.name }}</h2>

          {% if age.description %}
            <p>{{ age.description }}</p>
          {% endif %}

        </div>

      </div>

    </a>

  {% endfor %}

</div>


