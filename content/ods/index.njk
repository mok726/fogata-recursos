---
layout: layouts/base.njk
title: ODS
---

<h1>Objetivos de Desarrollo Sostenible</h1>

<div class="grid">

  {% for sdg in allSdgs  %}

    <a href="/ods/{{ sdg.id }}/">

      <div class="card">

        <img
          class="badge"
          src="/imagenes/ods/ods-{{ sdg.id }}.png"
          alt="ODS {{ sdg.id }}">

        <div class="card-content">

          <h2>
            ODS {{ sdg.id }}
          </h2>

          <p>
            {{ sdg.name }}
          </p>

        </div>

      </div>

    </a>

  {% endfor %}

</div>


