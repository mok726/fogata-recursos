<script>
  // Menú "Explorar por": se abre con clic, Enter o Espacio y se
  // cierra con Escape o al hacer clic afuera. El hover sigue
  // funcionando por CSS.
  (function () {

    var dropdown = document.querySelector(".navbar-dropdown");

    if (!dropdown) return;

    var button = dropdown.querySelector(".navbar-dropdown-button");

    function setOpen(open) {
      dropdown.classList.toggle("is-open", open);
      button.setAttribute("aria-expanded", open ? "true" : "false");
    }

    button.addEventListener("click", function () {
      setOpen(button.getAttribute("aria-expanded") !== "true");
    });

    dropdown.addEventListener("keydown", function (event) {
      if (event.key === "Escape") {
        setOpen(false);
        button.focus();
      }
    });

    dropdown.addEventListener("focusout", function (event) {
      if (!dropdown.contains(event.relatedTarget)) setOpen(false);
    });

    document.addEventListener("click", function (event) {
      if (!dropdown.contains(event.target)) setOpen(false);
    });

  })();
</script>

<script>
  // Selector de modo del encabezado: muestra el modo actual y arma
  // los enlaces a esta misma página con ?modo=... (o sin él).
  (function () {
    var caja = document.querySelector(".navbar-modo");
    if (!caja) return;
    var btn = caja.querySelector(".navbar-modo-btn");
    var menu = caja.querySelector(".navbar-modo-menu");
    var modo = document.documentElement.getAttribute("data-modo") || "";
    var nombres = { "": "todas las opciones", scout: "scout", docente: "docente" };
    var iconos = { "": "visibility", scout: "", docente: "school" };

    btn.querySelector(".navbar-modo-ico").textContent = iconos[modo];
    if (modo === "scout") btn.classList.add("con-lis");
    btn.title = "Ver como: " + nombres[modo] + " (cambiar)";
    btn.setAttribute("aria-label", btn.title);
    if (modo) btn.classList.add("activo");

    menu.querySelectorAll("[data-modo-opcion]").forEach(function (a) {
      var m = a.getAttribute("data-modo-opcion");
      var url = new URL(location.href);
      if (m) url.searchParams.set("modo", m); else url.searchParams.delete("modo");
      a.href = url.toString();
      if (m === modo) a.setAttribute("aria-current", "true");
    });

    function abrir(si) {
      menu.hidden = !si;
      btn.setAttribute("aria-expanded", si ? "true" : "false");
    }
    btn.addEventListener("click", function () { abrir(menu.hidden); });
    caja.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && !menu.hidden) { abrir(false); btn.focus(); }
    });
    document.addEventListener("click", function (e) {
      if (!caja.contains(e.target)) abrir(false);
    });
  })();
</script>
