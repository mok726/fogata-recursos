{#- Datos de la «Actividad del día» para JSON: espera `dias`
    ([{ fecha, item }], filtro actividadesDelDia) y `absoluto`
    (true: URLs completas, para redes/feeds). -#}
[{% for d in dias %}{% set it = d.item %}{% set img = it.data.image | thumb("og") %}
  {
    "fecha": {{ d.fecha | dump | safe }},
    "title": {{ (it.data.title | smartTitle) | dump | safe }},
    "description": {{ (it.data.description or it.data.summary or "") | dump | safe }},
    "url": {{ ((site.url if absoluto else "") + (it.url | url)) | dump | safe }},
    "image": {{ ((site.url if absoluto else "") + (img | url)) | dump | safe }},
    "card": {{ ((site.url if absoluto else "") + (it.data.image | thumb("card") | url)) | dump | safe }}
  }{% if not loop.last %},{% endif %}{% endfor %}
]
