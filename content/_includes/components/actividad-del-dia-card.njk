{#- Tarjeta de la «Actividad del día»: la misma card de la lista de
    actividades (con la descripción extendida) dentro de un envoltorio
    naranja con el encabezado «Actividad del día» y un pie.
    La usan la portada (pages/index.njk) y la imagen para redes
    (pages/redes-tarjeta.njk). Espera `d` ({ fecha, item }) y `loop`.
    Con `paraRedes` true, el pie es una placa con logo, nombre del
    sitio y URL de la ficha (en una imagen el link no sirve). -#}
{% set item = d.item.data %}
{% set activityUrl = d.item.url %}
<div class="home-daily-dia" data-fecha="{{ d.fecha }}" {% if not paraRedes and not loop.first %}hidden{% endif %}>

  <a class="home-daily-head" href="{{ activityUrl | url }}" tabindex="-1">
    <span class="material-symbols-outlined" aria-hidden="true">local_fire_department</span>
    <span class="home-daily-kicker">Actividad del día</span>
    <span class="home-daily-fecha">{{ d.fecha | fechaCorta }}</span>
  </a>

  {# Escritorio (no en redes): portada de la card a la izquierda y
     título, descripción, insignias y ODS a la derecha. #}
  {% if not paraRedes %}
  <div class="home-daily-ancha">
    {% set layout = "compact" %}
    {% include "components/activity-card.njk" %}
    <div class="home-daily-body">
      <h2 class="home-daily-title">
        <a href="{{ activityUrl | url }}">{{ item.title | smartTitle }}</a>
      </h2>
      <a class="home-daily-desc" href="{{ activityUrl | url }}" tabindex="-1">{{ item.description or item.summary }}</a>
      <div class="home-daily-sellos">
        <div class="home-daily-insignias">
        {% for rawBadge in (item.activity_badges or []).slice(0, 3) %}
          {% set badgeId = rawBadge.id if rawBadge.id else (rawBadge | slugify) %}
          <a href="{{ (badgeId | badgeHref(badges)) | url }}">
            <img class="badge-icon" loading="lazy" decoding="async"
              src="{{ (badgeId | badgeLogo(badges)) | url }}"
              alt="Insignia" title="{{ rawBadge.name if rawBadge.name else (rawBadge | smartTitle) }}">
          </a>
        {% endfor %}
        </div>
        <div class="home-daily-ods">
        {% for sdg in (item.sdgs or []).slice(0, 4) %}
          <a href="{{ ('/ods/' + sdg + '/') | url }}">
            <img class="sdg-icon" loading="lazy" decoding="async"
              src="{{ ('/imagenes/ods/ods-' + sdg + '.png') | url }}"
              alt="ODS {{ sdg }}" title="ODS {{ sdg }}">
          </a>
        {% endfor %}
        </div>
      </div>
    </div>
  </div>
  {% endif %}

  {# Móvil y redes: la card de la lista con la descripción extendida. #}
  <div class="home-daily-angosta">
    {% set layout = "" %}
    {% set cardTexto = item.description or item.summary %}
    {% include "components/activity-card.njk" %}
    {% set cardTexto = "" %}
  </div>

  {% if paraRedes %}
    <div class="home-daily-placa">
      <div>
        <b><img src="{{ '/imagenes/_thumbs/logo/favicon.webp' | url }}" alt="" width="24" height="24">Fogata de Recursos</b>
        {# <wbr> después de cada «/» para que la URL corte en lugares prolijos. #}
        <span>{{ (site.url + (activityUrl | url)) | replace("https://", "") | replace(r/\/$/, "") | replace(r/\//g, "/<wbr>") | safe }}</span>
      </div>
      {# QR de la ficha (los mismos de la versión para imprimir). #}
      <img class="home-daily-qr" src="{{ ('/imagenes/actividades/qr/' + d.item.fileSlug + '.png') | url }}" alt="QR de la actividad" width="96" height="96">
    </div>
  {% else %}
    <a class="home-daily-foot" href="{{ activityUrl | url }}">Ver la actividad →</a>
  {% endif %}

</div>
