<a
  class="card activity-card"
  href="{{ activityUrl | url }}"
>

  {% if item.activity_badges and item.activity_badges.length %}

    {% set rawBadge = item.activity_badges[0] %}

    {% if rawBadge.id %}

      {% set badgeId = rawBadge.id %}
      {% set badgeName = rawBadge.name %}

    {% else %}

      {% set badgeId = rawBadge | slugify %}
      {% set badgeName = rawBadge | smartTitle %}

    {% endif %}

    <div class="activity-card-badge">

      <img
        src="{{ ('/imagenes/insignias/' + badgeId + '.png') | url }}"
        alt="{{ badgeName }}">

    </div>

  {% endif %}

  <div class="card-content">

    <h3>
      {{ item.title | smartTitle }}
    </h3>

    {% if item.description %}

      <p>
        {{ item.description | truncate(140) }}
      </p>

    {% endif %}

    <div class="card-meta">

      {% if item.age_group %}

        {% for age in item.age_group.slice(0,2) %}

          {% set ageInfo = age | normalizeAge(ageGroups) %}

          <span
            class="chip age-chip"
            style="
              background: {{ ageInfo.color }}22;
              color: {{ ageInfo.color }};
            "
          >

            {{ ageInfo.name }}

          </span>

        {% endfor %}

      {% endif %}

      {% if item.duration %}

        <span class="chip">
          {{ item.duration }}
        </span>

      {% endif %}

    </div>

  </div>

</a>


