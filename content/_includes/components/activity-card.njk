<div class="card">

  {% set badge = null %}

{% if activity.data.activity_badges and activity.data.activity_badges.length %}

  {% set rawBadge = activity.data.activity_badges[0] %}

  {% if rawBadge.id %}

    {% set badge = rawBadge %}

  {% else %}

    {% set badge = {
      "id": rawBadge | slugify,
      "name": rawBadge
    } %}

  {% endif %}

  {% elif activity.data.badges and activity.data.badges.length %}

    {% set rawBadge = activity.data.badges[0] %}

    {% if rawBadge.id %}

      {% set badge = rawBadge %}

    {% else %}

      {% set badge = {
        "id": rawBadge | slugify,
        "name": rawBadge
      } %}

    {% endif %}

  {% endif %}

  {% if badge %}

    <div class="card-image">

      <img
        class="badge"
        src="/imagenes/insignias/{{ badge.id }}.png"
        alt="{{ badge.name }}">

    </div>

  {% endif %}

  <div class="card-content">

    <h2>
      {{ activity.data.title }}
    </h2>

    {% if activity.data.description %}

      <p class="card-description">
        {{ activity.data.description }}
      </p>

    {% endif %}

    <div class="meta">

      {% if activity.data.age_group %}

        <span class="chip">
          {{ activity.data.age_group | join(", ") }}
        </span>

      {% endif %}

      {% if activity.data.duration %}

        <span class="chip">
          {{ activity.data.duration }}
        </span>

      {% endif %}

    </div>

    {% if activity.data.sdgs %}

      <div class="sdgs">

        {% for sdg in activity.data.sdgs %}

          <img
            src="/imagenes/ods/ods-{{ sdg }}.png"
            alt="ODS {{ sdg }}">

        {% endfor %}

      </div>

    {% endif %}

  </div>

</div>


