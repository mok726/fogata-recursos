{% set item = activity.data %}

<div class="card activity-card">

  {% if item.activity_badges and item.activity_badges.length %}

    {% set rawBadge = item.activity_badges[0] %}

    {% if rawBadge.id %}

      {% set badgeId = rawBadge.id %}
      {% set badgeName = rawBadge.name %}

    {% else %}

      {% set badgeId = rawBadge | slugify %}
      {% set badgeName = rawBadge %}

    {% endif %}

    <div class="activity-card-badge">

      <img
        src="/imagenes/insignias/{{ badgeId }}.png"
        alt="{{ badgeName }}">

    </div>

  {% endif %}

  <div class="card-content">

    <h3>
      {{ item.title }}
    </h3>

    {% if item.description %}

      <p>
        {{ item.description | truncate(140) }}
      </p>

    {% endif %}

    <div class="card-meta">

      {% if item.age_group %}

        {% for age in item.age_group.slice(0,2) %}

          <span class="chip">
            {{ age }}
          </span>

        {% endfor %}

      {% endif %}

      {% if item.duration %}

        <span class="chip">
          {{ item.duration }}
        </span>

      {% endif %}

    </div>

  </div>

</div>

