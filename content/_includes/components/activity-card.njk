{% set cardActivity = activity or item %}

{% set badge = null %}

{% if cardActivity.data.activity_badges and cardActivity.data.activity_badges.length %}

  {% set rawBadge = cardActivity.data.activity_badges[0] %}

  {% if rawBadge.id %}

    {% set badge = rawBadge %}

  {% else %}

    {% set badge = {
      "id": rawBadge | slugify,
      "name": rawBadge
    } %}

  {% endif %}

{% endif %}

<article class="card activity-card">

  {% if badge %}

    <div class="activity-card-badge">

      <img
        src="/imagenes/insignias/{{ badge.id }}.png"
        alt="{{ badge.name }}">

    </div>

  {% endif %}

  <div class="card-content">

    <h3>
      {{ cardActivity.data.title }}
    </h3>

    {% if cardActivity.data.description %}

      <p>
        {{ cardActivity.data.description }}
      </p>

    {% endif %}

    <div class="card-meta">

      {% if cardActivity.data.age_group %}

        {% for age in cardActivity.data.age_group %}

          <span class="chip">
            {{ age }}
          </span>

        {% endfor %}

      {% endif %}

      {% if cardActivity.data.duration %}

        <span class="chip">
          {{ cardActivity.data.duration }}
        </span>

      {% endif %}

    </div>

  </div>

</article>


