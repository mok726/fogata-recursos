{# Íconos scout de fondo: los mismos adornos de hero-bosque.svg
   (brújula, nudo, huellas, carpa, hoja, estrella) más pino, fogata,
   montaña, luna, mochila, pájaro, hongo, farol y canoa, repartidos
   detrás del contenido. Puramente decorativo: aria-hidden y sin
   eventos. Las posiciones las arma el script según el alto de la
   página, con semilla en la URL para que cada página tenga su
   propio dibujo pero siempre el mismo. Sin JS no se ve nada. #}
<svg class="scout-deco-sprite" aria-hidden="true" focusable="false">
  <defs>
    <symbol id="sd-brujula" viewBox="-42 -44 84 84"><circle r="30"/><circle r="24" stroke-width="1.4"/><path d="M0-20L6 0 0 20-6 0Z"/><path d="M0-20L6 0H-6Z" fill="currentColor"/><path d="M0-30v-7M-3-40h6M30 0h5M-30 0h-5M0 30v5"/></symbol>
    <symbol id="sd-nudo" viewBox="-60 -36 120 72"><path d="M-55 6C-30 6-25-22 0-22S22 22 0 22-25-6 0-6 30 6 55 6"/><path d="M-55 -2C-30 -2-25-30 0-30S30 30 0 30-33-14 0-14 30 -2 55 -2" stroke-width="1.4"/></symbol>
    <symbol id="sd-huellas" viewBox="-30 -36 64 80"><g transform="translate(-10 4) rotate(-12)"><path d="M-11-20C-13-36 13-36 11-20C10-10 9-6 8 0H-8C-9-6-10-10-11-20Z"/><path d="M-8 6H8C9 14 6 22 0 22S-9 14-8 6Z"/></g><g transform="translate(14 -2) rotate(8)"><path d="M-11-20C-13-36 13-36 11-20C10-10 9-6 8 0H-8C-9-6-10-10-11-20Z"/><path d="M-8 6H8C9 14 6 22 0 22S-9 14-8 6Z"/></g></symbol>
    <symbol id="sd-carpa" viewBox="-66 -48 132 82"><path d="M-48 30L0-34 48 30Z"/><path d="M0-34L-10 30M0-34L10 30M-10 30L0 6 10 30"/><path d="M0-34l-6-10M0-34l6-10M-62 30H62"/></symbol>
    <symbol id="sd-hoja" viewBox="-18 -28 36 58"><path d="M0 20C-14 6-12-14 0-24 12-14 14 6 0 20Z"/><path d="M0 26V-18M0 0l-6-6M0 8l6-6M0-8l-5-5"/></symbol>
    <symbol id="sd-estrella" viewBox="-11 -11 22 22"><path d="M0-9Q0 0 9 0Q0 0 0 9Q0 0-9 0Q0 0 0-9Z"/></symbol>
    <symbol id="sd-pino" viewBox="-30 -44 60 88"><path d="M0-40L-14-16H-6L-20 6H-8L-24 28H24L8 6H20L6-16H14Z"/><path d="M-4 28V40H4V28"/></symbol>
    <symbol id="sd-fogata" viewBox="-40 -44 80 84"><path d="M-30 32L30 18M-30 18L30 32"/><path d="M0 14C-14 6-12-8-4-18C-4-8 2-8 2-14C10-6 14 6 0 14Z"/><path d="M0 9C-4 6-4 1 0-3 4 1 4 6 0 9Z" stroke-width="1.4"/></symbol>
    <symbol id="sd-montana" viewBox="-60 -36 120 70"><path d="M-56 30L-20-20-4 4 14-28 56 30Z"/><path d="M6-16l8 5 6-5M-28-8l8 4 5-5" stroke-width="1.4"/></symbol>
    <symbol id="sd-luna" viewBox="-24 -24 48 48"><path d="M8-20A20 20 0 1 0 8 20 16 16 0 1 1 8-20Z"/></symbol>
    <symbol id="sd-mochila" viewBox="-28 -38 56 76"><path d="M-20-14C-20-26 20-26 20-14V30H-20Z"/><path d="M-20-8H20M-12 6H12V22H-12Z"/><path d="M-8-24C-8-34 8-34 8-24"/></symbol>
    <symbol id="sd-pajaro" viewBox="-30 -14 60 28"><path d="M-26 0C-18-10-8-8 0 2 8-8 18-10 26 0"/></symbol>
    <symbol id="sd-hongo" viewBox="-30 -30 60 60"><path d="M-26 0C-26-22 26-22 26 0Z"/><path d="M-8 0V22H8V0"/><path d="M-12-10h1M6-14h1M12-6h1" stroke-width="3"/></symbol>
    <symbol id="sd-farol" viewBox="-20 -38 40 72"><path d="M-12-20H12L8 24H-8Z"/><path d="M-6-20V-28H6V-20M0-28V-34M-14 24H14"/><path d="M0-8C-4-2-4 4 0 8 4 4 4-2 0-8Z" stroke-width="1.4"/></symbol>
    <symbol id="sd-canoa" viewBox="-60 -32 120 60"><path d="M-54 4C-30 22 30 22 54 4Z"/><path d="M-54 4H54" stroke-width="1.4"/><path d="M26-28L6 12M6 12l-5 9 9-3Z"/></symbol>
  </defs>
</svg>
<div class="scout-deco" aria-hidden="true" data-seed="{{ page.url }}"></div>
<script>
(function () {
  var layer = document.querySelector('.scout-deco');
  if (!layer || !('ResizeObserver' in window)) return;

  var ICONS = ['brujula', 'nudo', 'huellas', 'carpa', 'hoja', 'pino',
               'fogata', 'montana', 'luna', 'mochila', 'pajaro', 'hongo',
               'farol', 'canoa', 'huellas', 'pino', 'hoja'];
  var NS = 'http://www.w3.org/2000/svg';
  var lastH = 0, lastW = 0, timer;

  // PRNG con semilla (mulberry32): mismo dibujo en cada visita.
  function rng(str) {
    var a = 0;
    for (var i = 0; i < str.length; i++) a = (a * 31 + str.charCodeAt(i)) | 0;
    return function () {
      a = (a + 0x6D2B79F5) | 0;
      var t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  function draw() {
    var h = document.documentElement.scrollHeight;
    var w = document.documentElement.clientWidth;
    lastH = h; lastW = w;

    var rand = rng(layer.dataset.seed || location.pathname);
    var narrow = w < 700;
    var frag = document.createDocumentFragment();
    var lastName = '';

    function pick() {
      var n;
      do { n = ICONS[Math.floor(rand() * ICONS.length)]; } while (n === lastName);
      lastName = n;
      return n;
    }

    function put(name, x, y, size, op) {
      var svg = document.createElementNS(NS, 'svg');
      var use = document.createElementNS(NS, 'use');
      use.setAttribute('href', '#sd-' + name);
      svg.appendChild(use);
      svg.setAttribute('class', 'scout-deco-icon');
      svg.style.cssText =
        'left:' + x.toFixed(1) + '%;top:' + Math.round(y) + 'px;' +
        'width:' + Math.round(size) + 'px;height:' + Math.round(size) + 'px;' +
        '--r:' + Math.round(rand() * 50 - 25) + 'deg;' +
        '--d:' + (9 + rand() * 8).toFixed(1) + 's;' +
        '--o:' + op.toFixed(2);
      frag.appendChild(svg);
    }

    function iconSize(name, k) {
      if (name === 'estrella') return 16 + rand() * 14;
      return (narrow ? 34 + rand() * 20 : 52 + rand() * 40) * (k || 1);
    }

    // Desde debajo de la barra de navegación hasta antes del pie.
    // Grilla con desorden: la página se divide en celdas y cada una
    // tiene un ícono (o no) en un lugar al azar dentro de la celda.
    // Así quedan desperdigados por todo el ancho, sin amontonarse ni
    // dejar huecos grandes. Más estrellitas sueltas.
    var cols = narrow ? 3 : (w < 1100 ? 5 : 7);
    var cellH = narrow ? 230 : 200;
    var base = narrow ? 0.13 : 0.17;
    for (var row = 0, y0 = 140; y0 < h - 200; row++, y0 += cellH) {
      for (var c = 0; c < cols; c++) {
        if (rand() < 0.32) continue;          // celda vacía
        var n = pick();
        var x = (c + 0.1 + rand() * 0.8) * 100 / cols;
        var y = y0 + rand() * cellH * 0.8;
        // los de los bordes un poco más chicos y del centro más tenues
        var edge = c === 0 || c === cols - 1;
        put(n, x, y, iconSize(n, edge ? 1 : 0.85 + rand() * 0.4),
            (edge ? base : base - 0.03) + rand() * 0.09);
      }
      if (rand() < 0.6) {
        put('estrella', 3 + rand() * 94, y0 + rand() * cellH,
            iconSize('estrella'), base + rand() * 0.1);
      }
    }
    layer.replaceChildren(frag);
  }

  // Redibuja si la página cambió de alto (p. ej. "cargar más" en
  // actividades) o de ancho. Con debounce para no hacerlo en cada px.
  new ResizeObserver(function () {
    var h = document.documentElement.scrollHeight;
    var w = document.documentElement.clientWidth;
    if (Math.abs(h - lastH) < 150 && w === lastW) return;
    clearTimeout(timer);
    timer = setTimeout(draw, 200);
  }).observe(document.body);

  draw();
})();
</script>
