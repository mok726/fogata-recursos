---
layout: layouts/base.njk
styles:
  - /css/pages/activities.css
fonts:
  - https://fonts.googleapis.com/css2?family=Rubik+Dirt&family=Roboto+Slab:wght@600;800&display=swap
---
{% set heroKicker = "Rama" %}
{% set heroTitle = age.name %}
{% set heroText = "De " + age.agefrom + " a " + age.ageto + " años." if age.agefrom else "" %}
{% set heroImage = ('/imagenes/ramas/' + age.icon) | thumb("rama") if age.icon else "" %}
{% set browserItems = collections.activitiesSorted | activitiesFor("age", age.id, ageGroups) %}
{% set fixed = { filter: "rama", text: age.name } %}
{% include "components/browse-page.njk" %}
