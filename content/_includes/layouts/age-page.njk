<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>{{ age.name }} - Fogata de Recursos</title>

  <style>

    body {
      font-family: Arial, sans-serif;
      margin: auto;
      max-width: 1200px;
      padding: 1rem;
      background: #f5f5f5;
      color: #222;
    }

    .header {
      margin-bottom: 2rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1rem;
    }

    .card {
      background: white;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .card-content {
      padding: 1rem;
    }

    .badge {
      width: 100%;
      height: 180px;
      object-fit: cover;
      background: #ddd;
    }

    .sdgs {
      display: flex;
      flex-wrap: wrap;
      gap: 0.3rem;
      margin-top: 1rem;
    }

    .sdgs img {
      width: 42px;
      border-radius: 4px;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    .meta {
      font-size: 0.9rem;
      color: #666;
      margin-top: 0.5rem;
    }

  </style>
</head>

<body>

<div class="header">

  <h1>{{ age.name }}</h1>

  <p>
    Actividades recomendadas para {{ age.name }}.
  </p>

</div>

<div class="grid">

{% for activity in collections.activities %}

  {% if activity.data.age_group and (age.name in activity.data.age_group) %}

    <a href="{{ activity.url }}">

      <div class="card">

        {% if activity.data.badges %}

          {% set badge = activity.data.badges[0] %}

          <img
            class="badge"
            src="/imagenes/insignias/{{ badge | slugify }}.png"
            alt="{{ badge }}">

        {% endif %}

        <div class="card-content">

          <h2>{{ activity.data.title }}</h2>

          {% if activity.data.description %}
            <p>{{ activity.data.description }}</p>
          {% endif %}

          <div class="meta">

            {% if activity.data.duration %}
              {{ activity.data.duration }}
            {% endif %}

          </div>

          <div class="sdgs">

            {% for sdg in activity.data.sdgs %}
              <img
                src="/imagenes/ods/ods-{{ sdg }}.png"
                alt="ODS {{ sdg }}">
            {% endfor %}

          </div>

        </div>

      </div>

    </a>

  {% endif %}

{% endfor %}

</div>

</body>
</html>


