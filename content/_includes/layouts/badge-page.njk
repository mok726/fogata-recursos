---
layout: layouts/base.njk
---

<section class="page-header">

  <img
src="{{ ('/imagenes/insignias/' + badge.id + '.png') | url }}"
    alt="{{ badge.name }}">

  <div>

    <h1>
      {{ badge.name }}
    </h1>

    <p>
      Actividades relacionadas con la insignia {{ badge.name }}.
    </p>

  </div>

</section>

<div class="grid">

  {% for activity in collections.activities %}

    {% if activity.data.activity_badges %}

      {% for item in activity.data.activity_badges %}

        {% if item | slugify == badge.id %}

          <a href="{{ activity.url  | url }}">

            {% set activity = activity %}

            {% include "components/activity-card.njk" %}

          </a>

        {% endif %}

      {% endfor %}

    {% endif %}

  {% endfor %}

</div>
