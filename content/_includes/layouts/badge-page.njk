<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>{{ badge.name }} - Fogata Recursos</title>

  <style>

    body {
      font-family: Arial, sans-serif;
      margin: auto;
      max-width: 1200px;
      padding: 1rem;
      background: #f5f5f5;
      color: #222;
    }

    .header {
      display: flex;
      gap: 2rem;
      align-items: center;
      margin-bottom: 2rem;
      flex-wrap: wrap;
    }

    .header img {
      width: 180px;
      border-radius: 12px;
      background: white;
      padding: 1rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1rem;
    }

    .card {
      background: white;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .card-content {
      padding: 1rem;
    }

    .sdgs {
      display: flex;
      gap: 0.3rem;
      flex-wrap: wrap;
      margin-top: 1rem;
    }

    .sdgs img {
      width: 42px;
      border-radius: 4px;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

  </style>
</head>

<body>

<div class="header">

  <img
    src="/imagenes/insignias/{{ badge.id }}.png"
    alt="{{ badge.name }}">

  <div>
    <h1>{{ badge.name }}</h1>

    <p>
      Actividades relacionadas con la insignia {{ badge.name }}.
    </p>
  </div>

</div>

<div class="grid">

{% for activity in collections.activities %}

  {% if activity.data.activity_badges and (badge.name in activity.data.activity_badges) %}

    <a href="{{ activity.url }}">

      <div class="card">

        <div class="card-content">

          <h2>{{ activity.data.title }}</h2>

          <p>{{ activity.data.description }}</p>

          <div class="sdgs">

            {% for sdg in activity.data.sdgs %}
              <img
                src="/imagenes/ods/ods-{{ sdg }}.png"
                alt="ODS {{ sdg }}">
            {% endfor %}

          </div>

        </div>

      </div>

    </a>

  {% endif %}

{% endfor %}

</div>

</body>
</html>


