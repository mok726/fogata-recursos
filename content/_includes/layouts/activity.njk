<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>{{ title }} - Fogata Recursos</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      margin: auto;
      max-width: 900px;
      padding: 1rem;
      line-height: 1.6;
      background: #f5f5f5;
      color: #222;
    }

    .card {
      background: white;
      padding: 2rem;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .badge-header {
      display: flex;
      gap: 1rem;
      align-items: center;
      margin-bottom: 1rem;
      flex-wrap: wrap;
    }

    .badge-header img {
      width: 90px;
      border-radius: 10px;
    }

    .sdg-list {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin-top: 1rem;
    }

    .sdg-list img {
      width: 64px;
      border-radius: 6px;
    }

    .meta {
      background: #f0f0f0;
      padding: 1rem;
      border-radius: 8px;
      margin: 1rem 0;
    }

    ul {
      padding-left: 1.2rem;
    }

    @media (max-width: 600px) {
      .badge-header {
        flex-direction: column;
        align-items: flex-start;
      }

      .badge-header img {
        width: 70px;
      }

      .sdg-list img {
        width: 52px;
      }
    }
  </style>
</head>

<body>

<div class="card">

  <div class="badge-header">

{% if activity_badges %}
{% for badge in activity_badges  %}

{% if badge.id %}
  {% set badgeId = badge.id %}
  {% set badgeName = badge.name %}
{% else %}
  {% set badgeId = badge | slugify %}
  {% set badgeName = badge %}
{% endif %}

<img
  src="/imagenes/insignias/{{ badgeId }}.png"
  alt="{{ badgeName }}"
>

  {% endfor %}
{% endif %}


    <div>
      <h1>{{ title }}</h1>

      {% if description %}
        <p>{{ description }}</p>
      {% endif %}
    </div>

  </div>

  <div class="meta">

    {% if age_group %}
      <p>
        <strong>Grupo etario:</strong>
        {{ age_group | join(", ") }}
      </p>
    {% endif %}

    {% if duration %}
      <p>
        <strong>Duración:</strong>
        {{ duration }}
      </p>
    {% endif %}

    {% if tags %}
      <p>
        <strong>Tags:</strong>
        {{ tags | join(", ") }}
      </p>
    {% endif %}

  </div>

  {% if materials %}
    <h2>Materiales</h2>

    <ul>
      {% for item in materials %}
        <li>{{ item }}</li>
      {% endfor %}
    </ul>
  {% endif %}

  <h2>ODS relacionados</h2>

  <div class="sdg-list">
    {% for sdg in sdgs %}
      <img
        src="/imagenes/ods/ods-{{ sdg }}.png"
        alt="ODS {{ sdg }}">
    {% endfor %}
  </div>

</div>

</body>
</html>


