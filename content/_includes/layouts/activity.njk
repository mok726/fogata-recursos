---
layout: layouts/base.njk
---

<article class="activity-page">

  <nav class="breadcrumbs">

<a href="{{ '/' | url }}">
      Inicio
    </a>

    <span>
      /
    </span>

<a href="{{ '/activities/' | url }}">
      Actividades
    </a>

    <span>
      /
    </span>

    <span>
      {{ title }}
    </span>

  </nav>
  {% set badge = null %}

  {% if activity_badges and activity_badges.length %}

    {% set rawBadge = activity_badges[0] %}

    {% if rawBadge.id %}

      {% set badge = rawBadge %}

    {% else %}

      {% set badge = {
        "id": rawBadge | slugify,
        "name": rawBadge
      } %}

    {% endif %}

  {% endif %}

  <header class="activity-hero">

    {% if badge %}

      <div class="activity-badge">

        <img
src="{{ ('/imagenes/insignias/' + badge.id + '.png') | url }}"
          alt="{{ badge.name }}">

      </div>

    {% endif %}

    <div class="activity-hero-content">

      <h1>
        {{ title }}
      </h1>

      {% if description %}

        <p class="activity-description">
          {{ description }}
        </p>

      {% endif %}

      <div class="meta">

        {% if age_group %}

          <span class="chip">
            {{ age_group | join(", ") }}
          </span>

        {% endif %}

        {% if duration %}

          <span class="chip">
            {{ duration }}
          </span>

        {% endif %}

        {% if difficulty %}

          <span class="chip">
            {{ difficulty }}
          </span>

        {% endif %}

      </div>


<div class="activity-tags">

  {% if categories %}

    {% for category in categories %}

      <span class="tag">
        {{ category }}
      </span>

    {% endfor %}

  {% endif %}

  {% if location %}

    {% for place in location %}

      <span class="tag">
        {{ place }}
      </span>

    {% endfor %}

  {% endif %}

</div>



      {% if sdgs %}

        <div class="sdgs">

          {% for sdg in sdgs %}

<a href="{{ ('/ods/' + sdg + '/') | url }}">
              <img

src="{{ ('/imagenes/ods/ods-' + sdg + '.png') | url }}"
                alt="ODS {{ sdg }}">

            </a>

          {% endfor %}

        </div>

      {% endif %}

    </div>

  </header>

  {% if materials %}

    <section class="info-box">

      <h2>
        Materiales
      </h2>

      <ul>

        {% for item in materials %}

          <li>
            {{ item }}
          </li>

        {% endfor %}

      </ul>

    </section>

  {% endif %}

  {% if educational_objectives %}

    <section class="info-box">

      <h2>
        Objetivos educativos
      </h2>

      <ul>

        {% for item in educational_objectives %}

          <li>
            {{ item }}
          </li>

        {% endfor %}

      </ul>

    </section>

  {% endif %}

  <section class="activity-content">

    {{ content | safe }}

  </section>



{% set related = collections.activities | reverse %}
<section class="related-section">

  <h2>
    Actividades relacionadas
  </h2>

  <div class="grid">

    {% for item in related %}

  {% if loop.index <= 4 %}

      {% if item.url != page.url %}

        <a href="{{ item.url | url  }}">

{% set activity = item %}

{% include "components/activity-card.njk" %}

        </a>

            {% endif %}

    {% endif %}

  {% endfor %}


  </div>

</section>



</article>


