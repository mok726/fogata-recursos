---
layout: layouts/base.njk
---

<article class="activity-page">

  {# ===== BREADCRUMBS ===== #}
  <nav class="breadcrumbs">
    <a href="{{ '/' | url }}">Inicio</a>
    <span>/</span>
    <a href="{{ '/activities/' | url }}">Actividades</a>
    <span>/</span>
    <span>{{ title }}</span>
  </nav>

  {# ===== HERO BANNER ===== #}
  {% set heroImage = image or '/imagenes/actividades/activity-card.png' %}

  <header class="activity-hero">
    <div class="activity-hero-banner">
      <img class="activity-hero-image" src="{{ heroImage | url }}" alt="{{ title }}">
      <div class="activity-hero-overlay"></div>

      {# Duración #}
      {% if duration %}
        <div class="activity-hero-duration">⏱ {{ duration }}</div>
      {% endif %}

      {# Rangos de edad #}
      {% if age_group %}
        <div class="activity-hero-ages">
          {% for age in age_group %}
            {% set ageId = age | slugify %}
            {% set ageData = null %}
            {% for group in ageGroups %}
              {% if group.id == ageId %}
                {% set ageData = group %}
              {% endif %}
            {% endfor %}
            {% if ageData and ageData.icon %}
              <a href="{{ ('/edades/' + ageId + '/') | url }}">
                <img class="branch-icon" src="{{ ('/imagenes/ramas/' + ageData.icon) | url }}" alt="{{ ageData.name }}">
              </a>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      {# Contenido principal del hero #}
      <div class="activity-hero-content">
        <h1>{{ title }}</h1>
        {% if summary %}
          <p class="activity-description">{{ summary }}</p>
        {% elseif description %}
          <p class="activity-description">{{ description }}</p>
        {% endif %}
      </div>

      {# ODS en hero #}
      {% if sdgs %}
        <div class="activity-hero-sdgs">
          {% for sdg in sdgs %}
            <a href="{{ ('/ods/' + sdg + '/') | url }}">
              <img class="sdg-icon" src="{{ ('/imagenes/ods/ods-' + sdg + '.png') | url }}" alt="ODS {{ sdg }}">
            </a>
          {% endfor %}
        </div>
      {% endif %}

      {# Badges en hero #}
      <div class="activity-hero-bottom-right">
        {% if activity_badges %}
          <div class="activity-hero-badges">
            {% for rawBadge in activity_badges %}
              {% set badgeId = rawBadge.id if rawBadge.id else (rawBadge | slugify) %}
              {% set badgeName = rawBadge.name if rawBadge.id else rawBadge %}
              <a href="{{ ('/badges/' + badgeId + '/') | url }}">
                <img class="badge-icon" src="{{ ('/imagenes/insignias/' + badgeId + '.png') | url }}" alt="{{ badgeName }}">
              </a>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      {# Actividad original #}
      {% if original %}
        <div class="activity-original-banner">Actividad original</div>
      {% endif %}
    </div>
  </header>




{# ==========================================
   ACTION BAR
========================================== #}

<div class="activity-action-bar">

  <div class="activity-action-left">

    <span class="activity-breadcrumb-short">
      Actividades
    </span>

  </div>

  <div class="activity-action-right">

    <button class="action-button">
      🔖 Guardar
    </button>

    <button class="action-button">
      🔗 Compartir
    </button>

  </div>

</div>


{# ==========================================
   MAIN LAYOUT
========================================== #}

<div class="activity-layout">

  {# ======================================
     LEFT SIDEBAR
  ====================================== #}

  <aside class="activity-sidebar">

    <div class="sidebar-card">

      <h2>📋 Información rápida</h2>

      {% if ideal_for %}
      <p><strong>Tipo:</strong> {{ ideal_for | join(", ") }}</p>
      {% endif %}

      {% if duration %}
      <p><strong>Duración:</strong> {{ duration }}</p>
      {% endif %}

      {% if participants %}
      <p><strong>Participantes:</strong> {{ participants }}</p>
      {% endif %}

      {% if age_group %}
      <p><strong>Rama:</strong> {{ age_group | join(", ") }}</p>
      {% endif %}

      {% if location %}
      <p><strong>Espacio:</strong> {{ location }}</p>
      {% endif %}

      {% if complexity %}
      <p><strong>Complejidad:</strong> {{ complexity }}</p>
      {% endif %}

    </div>


    {% if materials %}
    <div class="sidebar-card">

      <h2>🛠 Materiales</h2>

      <ul>
      {% for item in materials %}
        <li>{{ item }}</li>
      {% endfor %}
      </ul>

    </div>
    {% endif %}


    {% if tools %}
    <div class="sidebar-card">

      <h2>🔧 Herramientas</h2>

      <ul>
      {% for item in tools %}
        <li>{{ item }}</li>
      {% endfor %}
      </ul>

    </div>
    {% endif %}


    {% if competencies %}
    <div class="sidebar-card">

      <h2>🎯 Competencias</h2>

      <ul>
      {% for item in competencies %}
        <li>{{ item }}</li>
      {% endfor %}
      </ul>

    </div>
    {% endif %}


    {% if educational_objectives %}
    <div class="sidebar-card">

      <h2>📚 Objetivos educativos</h2>

      <ul>
      {% for item in educational_objectives %}
        <li>{{ item }}</li>
      {% endfor %}
      </ul>

    </div>
    {% endif %}


    {% if responsible %}
    <div class="sidebar-card">

      <h2>👥 Responsables</h2>

      {% if responsible is string %}
        <p>{{ responsible }}</p>
      {% else %}
        <ul>
        {% for item in responsible %}
          <li>{{ item }}</li>
        {% endfor %}
        </ul>
      {% endif %}

    </div>
    {% endif %}


    {% if required %}
    <div class="sidebar-card required-sidebar">

      <h2>⚠ Actividad requerida</h2>

      {% if required_category %}
      <p><strong>{{ required_category }}</strong></p>
      {% endif %}

      {% if required_comment %}
      <p>{{ required_comment }}</p>
      {% endif %}

    </div>
    {% endif %}

  </aside>


  {# ======================================
     MAIN CONTENT
  ====================================== #}

  <section class="activity-content">

    {% if summary %}
    <div class="activity-summary-box">

      <h2>Resumen</h2>

      <p>{{ summary }}</p>

    </div>
    {% endif %}

    {{ content | safe }}

  </section>


  {# ======================================
     RIGHT SIDEBAR
  ====================================== #}

  <aside class="activity-sidebar">

    {% if sdgs %}
    <div class="sidebar-card">

      <h2>🌎 ODS</h2>

      <div class="sidebar-sdgs">

        {% for sdg in sdgs %}

          <a href="{{ ('/ods/' + sdg + '/') | url }}">

            <img
              class="sdg-icon"
              src="{{ ('/imagenes/ods/ods-' + sdg + '.png') | url }}"
              alt="ODS {{ sdg }}">

          </a>

        {% endfor %}

      </div>

    </div>
    {% endif %}


    {% if activity_badges %}
    <div class="sidebar-card">

      <h2>🏅 Insignias</h2>

      <div class="sidebar-badges">

        {% for rawBadge in activity_badges %}

          {% if rawBadge.id %}
            {% set badgeId = rawBadge.id %}
          {% else %}
            {% set badgeId = rawBadge | slugify %}
          {% endif %}

          <a href="{{ ('/badges/' + badgeId + '/') | url }}">

            <img
              class="badge-icon"
              src="{{ ('/imagenes/insignias/' + badgeId + '.png') | url }}"
              alt="">

          </a>

        {% endfor %}

      </div>

    </div>
    {% endif %}


    {% if tags %}
    <div class="sidebar-card">

      <h2>🏷 Etiquetas</h2>

      <div class="tag-cloud">

        {% for tag in tags %}
          <span class="tag-pill">{{ tag }}</span>
        {% endfor %}

      </div>

    </div>
    {% endif %}


    {% if files %}
    <div class="sidebar-card">

      <h2>📎 Archivos</h2>

      <div class="sidebar-files">

        {% for file in files %}

        <a
          class="sidebar-file"
          href="{{ file.filepath }}">

          <div class="sidebar-file-icon">

            {% if file.icon == "pdf" %}
              📄
            {% elseif file.icon == "imagen" %}
              🖼️
            {% else %}
              📦
            {% endif %}

          </div>

          <div class="sidebar-file-info">

            <strong>{{ file.icon | upper }}</strong>

            <div>{{ file.caption }}</div>

          </div>

        </a>

        {% endfor %}

      </div>

    </div>
    {% endif %}

  </aside>

</div>




  {# ===== FOOTER ===== #}
  <footer class="activity-footer">

    {# Referencias #}
    {% if references %}
      <section class="footer-card">
        <h2>📖 Referencias</h2>
        <div class="reference-grid">
          {% for ref in references %}
            <div class="reference-card">
              <strong>{{ ref.title }}</strong>
              {% if ref.author %}<div>{{ ref.author }}</div>{% endif %}
              {% if ref.year %}<div>{{ ref.year }}</div>{% endif %}
              {% if ref.series %}<div>{{ ref.series }}</div>{% endif %}
              {% if ref.url %}<a href="{{ ref.url }}">Ver documento</a>{% endif %}
            </div>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {# Atribuciones #}
    {% if attributions %}
      <section class="footer-card">
        <h2>👏 Atribuciones</h2>
        <ul>
          {% for item in attributions %}
            <li>
              <strong>{{ item.entity }}</strong> — {{ item.role }}
              {% if item.year %}({{ item.year }}){% endif %}
            </li>
          {% endfor %}
        </ul>
      </section>
    {% endif %}

    {# Licencia #}
    {% if license %}
      <section class="footer-card">
        <h2>📜 Licencia</h2>
        <div class="license-info">
          {% if license.image %}
            <img src="{{ license.image }}" alt="{{ license.name }}">
          {% endif %}
          <div>
            <strong>{{ license.name }}</strong>
            {% if license.url %}
              <br><a href="{{ license.url }}" target="_blank">Ver licencia</a>
            {% endif %}
          </div>
        </div>
      </section>
    {% endif %}

    {# Aviso de traducción #}
    {% if translation_notice and translation_notice.es %}
      <section class="footer-card translation-card">
        <h2>🌐 Aviso de traducción</h2>
        <p>{{ translation_notice.es }}</p>
      </section>
    {% endif %}

    {# Créditos #}
    {% if source or author %}
      <section class="footer-card">
        <h2>💎 Créditos</h2>
        <ul>
          {% if author %}<li>Autor: {{ author }}</li>{% endif %}
          {% if source %}<li>Fuente: {{ source }}</li>{% endif %}
        </ul>
      </section>
    {% endif %}
  </footer>

  {# ===== SEPARADOR ===== #}
  <hr class="activity-end-divider">

  {# ===== ACTIVIDADES RELACIONADAS ===== #}
  {% set related = collections.activitiesSorted | reverse %}
  <section class="related-section">
    <h2>✨ También te puede interesar</h2>
    <div class="grid">
      {% for item in related %}
        {% if loop.index <= 4 and item.url != page.url %}
          {% set relatedActivity = item %}
          {% set item = relatedActivity.data %}
          {% set activityUrl = relatedActivity.url %}
          {% include "components/activity-card.njk" %}
        {% endif %}
      {% endfor %}
    </div>
  </section>

</article>
