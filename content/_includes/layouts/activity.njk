---
layout: layouts/base.njk
---


<div class="card">

  <div class="badge-header">

{% if activity_badges %}
{% for badge in activity_badges  %}

{% if badge.id %}
  {% set badgeId = badge.id %}
  {% set badgeName = badge.name %}
{% else %}
  {% set badgeId = badge | slugify %}
  {% set badgeName = badge %}
{% endif %}

<img
  src="/imagenes/insignias/{{ badgeId }}.png"
  alt="{{ badgeName }}"
>

  {% endfor %}
{% endif %}


    <div>
      <h1>{{ title }}</h1>

      {% if description %}
        <p>{{ description }}</p>
      {% endif %}
    </div>

  </div>

  <div class="meta">

    {% if age_group %}
      <p>
        <strong>Grupo etario:</strong>
        {{ age_group | join(", ") }}
      </p>
    {% endif %}

    {% if duration %}
      <p>
        <strong>Duración:</strong>
        {{ duration }}
      </p>
    {% endif %}

    {% if tags %}
      <p>
        <strong>Tags:</strong>
        {{ tags | join(", ") }}
      </p>
    {% endif %}

  </div>

  {% if materials %}
    <h2>Materiales</h2>

    <ul>
      {% for item in materials %}
        <li>{{ item }}</li>
      {% endfor %}
    </ul>
  {% endif %}

  <h2>ODS relacionados</h2>

  <div class="sdg-list">
    {% for sdg in sdgs %}
      <img
        src="/imagenes/ods/ods-{{ sdg }}.png"
        alt="ODS {{ sdg }}">
    {% endfor %}
  </div>

</div>



