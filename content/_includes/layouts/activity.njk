  {% if nextActivity %}
  <a
    class="activity-nav-card next"
    href="{{ nextActivity.url | url }}">

    <span class="nav-label">
      Actividad siguiente →
    </span>

    <strong>
      {{ nextActivity.data.title }}
    </strong>

  </a>
  {% endif %}

</section>



