{# Programa Scout: al tocar, pasar el mouse o llegar con el teclado
   a un número se abre una tarjetita con el rastro o la competencia,
   pegada al número. Tocar la tarjetita lleva a esa competencia en
   /competencias/. Sin JavaScript, el número lleva ahí directo. #}
<div class="competencia-pop" id="competencia-pop" role="tooltip" hidden>
  <button type="button" class="competencia-pop-cerrar" aria-label="Cerrar">
    <span class="material-symbols-outlined" aria-hidden="true">close</span>
  </button>
  <a class="competencia-pop-cuerpo" href="">
    <span class="competencia-pop-titulo"></span>
    <span class="competencia-pop-cat"></span>
    <span class="competencia-pop-texto"></span>
    <span class="competencia-pop-link">Ver en la lista de la rama <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></span>
  </a>
</div>
<script>
(function () {
  var pop = document.getElementById('competencia-pop');
  if (!pop) return;
  var cuerpo = pop.querySelector('.competencia-pop-cuerpo');
  var titulo = pop.querySelector('.competencia-pop-titulo');
  var cat = pop.querySelector('.competencia-pop-cat');
  var texto = pop.querySelector('.competencia-pop-texto');
  var actual = null;
  var fijo = false;   // abierta con clic: no se cierra al sacar el mouse
  var timer = null;

  function cerrar() {
    clearTimeout(timer);
    pop.hidden = true;
    if (actual) { actual.setAttribute('aria-expanded', 'false'); actual.removeAttribute('aria-describedby'); }
    actual = null;
    fijo = false;
  }

  function ubicar(pill) {
    // Coordenadas relativas al contenedor posicionado de la tarjetita.
    var base = pop.offsetParent || document.body;
    var b = base.getBoundingClientRect();
    var r = pill.getBoundingClientRect();
    var ancho = pop.offsetWidth;
    var alto = pop.offsetHeight;
    var vw = document.documentElement.clientWidth;
    var x = Math.min(Math.max(8, r.left), vw - ancho - 8);
    // Abajo del número; si no entra en la pantalla, arriba.
    var y = r.bottom + 6;
    pop.classList.remove('arriba');
    if (y + alto > window.innerHeight - 8 && r.top - alto - 6 > 8) {
      y = r.top - alto - 6;
      pop.classList.add('arriba');
    }
    pop.style.left = (x - b.left + (base.scrollLeft || 0)) + 'px';
    pop.style.top = (y - b.top + (base.scrollTop || 0)) + 'px';
    pop.style.setProperty('--flecha-x', Math.max(12, Math.min(ancho - 24, r.left + r.width / 2 - x - 6)) + 'px');
  }

  function abrir(pill, conClic) {
    clearTimeout(timer);
    if (actual && actual !== pill) actual.setAttribute('aria-expanded', 'false');
    var info = (pill.getAttribute('data-info') || '').split('\n');
    titulo.textContent = (pill.dataset.rama ? pill.dataset.rama + ' · ' : '') + (info[0] || '');
    cat.textContent = (info[1] || '').trim();
    texto.textContent = info.slice(2).join(' ').replace(/\s+/g, ' ').trim();
    cuerpo.href = pill.href;
    pop.hidden = false;
    ubicar(pill);
    actual = pill;
    fijo = !!conClic;
    pill.setAttribute('aria-expanded', 'true');
    pill.setAttribute('aria-describedby', 'competencia-pop');
  }

  function cerrarLuego() {
    if (fijo) return;
    clearTimeout(timer);
    timer = setTimeout(cerrar, 250);
  }

  var puedeHover = window.matchMedia && window.matchMedia('(hover: hover)').matches;

  document.querySelectorAll('.competencia-pill[href]').forEach(function (pill) {
    pill.setAttribute('aria-expanded', 'false');
    pill.addEventListener('click', function (e) {
      if (e.ctrlKey || e.metaKey || e.shiftKey) return;
      e.preventDefault();
      if (actual === pill && fijo) { cerrar(); return; }
      abrir(pill, true);
    });
    if (puedeHover) {
      pill.addEventListener('mouseenter', function () { if (!fijo || actual !== pill) abrir(pill, false); });
      pill.addEventListener('mouseleave', cerrarLuego);
    }
    pill.addEventListener('focus', function () { if (!actual || actual !== pill) abrir(pill, false); });
    pill.addEventListener('blur', function () { setTimeout(function () { if (!pop.contains(document.activeElement)) cerrarLuego(); }, 0); });
  });

  pop.addEventListener('mouseenter', function () { clearTimeout(timer); });
  pop.addEventListener('mouseleave', cerrarLuego);

  pop.querySelector('.competencia-pop-cerrar').addEventListener('click', function () {
    var p = actual; cerrar(); if (p) p.focus({ preventScroll: true });
  });
  document.addEventListener('click', function (e) {
    if (!pop.hidden && !pop.contains(e.target) && !e.target.closest('.competencia-pill')) cerrar();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !pop.hidden) { var p = actual; cerrar(); if (p) p.focus({ preventScroll: true }); }
  });
  window.addEventListener('resize', cerrar);
})();
</script>
