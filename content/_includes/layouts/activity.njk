---
layout: layouts/base.njk

styles:
  - /css/pages/activity.css


---
<script>

async function shareActivity() {

  const url = window.location.href;


  try {

    if (navigator.share) {

      await navigator.share({
        title: document.title,
        url
      });

      return;
    }

    if (navigator.clipboard) {

      await navigator.clipboard.writeText(url);

      alert("Enlace copiado al portapapeles");

      return;
    }

    prompt("Copiá este enlace:", url);

  } catch(err) {

    console.error(err);

  }
}

</script>

<article class="activity-page">

  {# ===== HERO CON IMAGEN DE FONDO ===== #}
  {% set heroImage = image or '/imagenes/actividades/activity-card.png' %}
  <div class="activity-hero" style="background-image: linear-gradient(90deg, rgba(0,0,0,0.7), rgba(0,0,0,0.2)), url('{{ heroImage | url }}');">
    <div class="activity-hero-container"
      data-pagefind-meta="edades:{{ ( age_group | ageRange ) or 'Todas las edades' }}">
      <div class="hero-left">
        {% if main_type %}
        <a class="hero-category" data-pagefind-meta="tipo" href="{{ ('/activityType/' + (main_type | string | slugify) + '/') | url }}" title="Ver actividades de este tipo">{{ main_type }}</a>
        {% else %}
        <div class="hero-category">{{ ((etiquetas or []) | first) or "Actividad" }}</div>
        {% endif %}
        <h1 class="hero-title">{{ title }}
{% if version %}
{% if version | isDraft %}
<span class="hero-version version-draft" title="Actividad pendiente de revisión manual">BORRADOR</span>
{% else %}
<span class="hero-version">v{{ version }}</span>
{% endif %}
{% endif %}
</h1>
        <p class="hero-description" data-pagefind-meta="resumen">{{ summary or description }}</p>

<div class="hero-metrics">
  <span><span class="material-symbols-outlined" aria-hidden="true">groups</span> {{ participants or "N/E" }}</span>
  <span><span class="material-symbols-outlined" aria-hidden="true">schedule</span> {{ duration or "N/E" }}</span>
  <span><span class="material-symbols-outlined" aria-hidden="true">productivity</span> {{ age or "Todas" }}</span>
</div>

        <div class="hero-tags">
          {% if etiquetas %}
            {% for tag in etiquetas %}
              {% set colorClass = ["green", "orange", "blue", "purple"][loop.index0 % 4] %}
              <span class="hero-tag {{ colorClass }}">{{ tag }}</span>
            {% endfor %}
          {% endif %}
        </div>
      </div>
    </div>
  </div>


  {# Contenido central (90% ancho, centrado) #}
  <div class="activity-content-wrapper">


  {# ===== BREADCRUMB + ACCIONES ===== #}
  <div class="activity-toolbar">
    {# js/migas.js la cambia por el camino real si se llegó desde
       una insignia, rama, búsqueda, etc. #}
    <nav class="breadcrumbs" data-migas aria-label="Migas de pan">
      <a href="{{ '/' | url }}">Inicio</a> >
      <a href="{{ '/activities/' | url }}">Actividades</a> >
      <span>{{ title }}</span>
    </nav>

<div class="activity-actions">
<a
  href="{{ page.url | url }}print/"
  target="_blank">
  Version Imprimible
</a>


 <button onclick="shareActivity()">
    <span class="material-symbols-outlined" aria-hidden="true">share</span> Compartir
  </button>
</div>
</div>
  {# ===== LAYOUT DE TRES COLUMNAS ===== #}



  <div class="three-columns">

    {# COLUMNA IZQUIERDA #}

<aside class="col-left">
  {# 1. INFORMACIÓN RÁPIDA #}



{# ===== INFORMACI ^sN R ^aPIDA (bloque completo) ===== #}
<div class="full-width-info">
  <div class="info-card quick-info">


<aside>
<div class="panel">

  <h3>
    <span class="material-symbols-outlined" aria-hidden="true">
      format_list_bulleted
    </span>
    Información rápida
  </h3>

  <div class="info-item">
    <div class="label">Tipo de actividad</div>
    <div class="value">
      {% if main_type %}<a href="{{ ('/activityType/' + (main_type | string | slugify) + '/') | url }}">{{ main_type }}</a>{% else %}{{ (activity_type or []) | first or "N/E" }}{% endif %}
    </div>
  </div>

  <div class="info-item">
    <div class="label">Duración</div>
    <div class="value">
      {{ duration or "N/E" }}
    </div>
  </div>

  <div class="info-item">
    <div class="label">Cantidad de participantes</div>
    <div class="value">
      {{ participants or "N/E" }}
    </div>
  </div>

  <div class="info-item">
    <div class="label">Rango de edad</div>
    <div class="value">
      {% if age %}
         {{ age }} 
      {% else %}
         {{ ( age_group | ageRange ) or "N/E" }}
      {% endif %}
    </div>
  </div>

  <div class="info-item">
    <div class="label">Espacio</div>
    <div class="value">
      {{ location or "N/E" }}
    </div>
  </div>

</div>
</aside>
  </div>
</div>



{% if complexity_execution
   or complexity_organizer
   or ludic_component
   or reflective_component
   or active_component %}

<div class="info-card">
  <h3>
    <span class="material-symbols-outlined" aria-hidden="true">
      analytics
    </span>
    Perfil de la Actividad
  </h3>

  <div class="metric-group">
    <div class="metric-row">
      <span>Complejidad ejecución</span>
    </div>

<div class="metric-dots">
  {% for i in [1,2,3,4,5] %}
    <span class="metric-dot {% if i <= (complexity_execution or 0) %}filled{% endif %}">
    </span>
  {% endfor %}
      <span>{{ complexity_execution }}/5</span>
</div>

    <div class="metric-row">
      <span>Complejidad organizador</span>
    </div>
<div class="metric-dots">
  {% for i in [1,2,3,4,5] %}
    <span class="metric-dot {% if i <= (complexity_organizer or 0) %}filled{% endif %}">
    </span>
  {% endfor %}
      <span>{{ complexity_organizer }}/5</span>
</div>
    <hr>

    <div class="metric-row">
      <span>Lúdico</span>
    </div>

<div class="metric-dots">
  {% for i in [1,2,3,4,5] %}
    <span class="metric-dot {% if i <= (ludic_component or 0) %}filled{% endif %}">
    </span>
  {% endfor %}
      <span>{{ ludic_component }}/5</span>
</div>



    <div class="metric-row">
      <span>Reflexivo</span>
    </div>


<div class="metric-dots">
  {% for i in [1,2,3,4,5] %}
    <span class="metric-dot {% if i <= (reflective_component or 0) %}filled{% endif %}">
    </span>
  {% endfor %}
     <span>{{ reflective_component }}/5</span>

</div>


    <div class="metric-row">
      <span>Activo</span>
    </div>


<div class="metric-dots">
  {% for i in [1,2,3,4,5] %}
    <span class="metric-dot {% if i <= (active_component or 0) %}filled{% endif %}">
    </span>
  {% endfor %}
      <span>{{ active_component }}/5</span>
</div>

  </div>
</div>

{% endif %}







  {# 2. MATERIALES (si existen) #}
  {% if (materials | default([])) | length or (special_materials | default([])) | length %}
  <div class="info-card">
    <h3><span class="material-symbols-outlined" aria-hidden="true">handyman</span> Materiales</h3>
    <div class="tag-list">
      {% for item in (materials | default([])) %}
        <span class="tag">{{ item }}</span>
      {% endfor %}
      {% for item in (special_materials | default([])) %}
        <span class="tag">{{ item }}</span>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {# 3. HABILIDADES (skills) #}

  {# 4. ODS RELACIONADOS #}
  {% if (sdgs | default([])) | length %}
  <div class="info-card sidebar-late">
  <h3><span class="material-symbols-outlined" aria-hidden="true">public</span> Alineado a los ODS</h3>

  <div class="sidebar-sdgs large-ods">
    {% for sdg in sdgs %}
      <a href="{{ ('/ods/' + sdg + '/') | url }}">
        <img src="{{ ('/imagenes/ods/ods-' + sdg + '.png') | url }}" alt="ODS {{ sdg }}" title="ODS {{ sdg }}" class="ods-icon-large">
      </a>
    {% endfor %}
  </div>

  </div>
  {% endif %}

  {# 5. INSIGNIAS RELACIONADAS #}
  {% if (activity_badges | default([])) | length %}
  <div class="info-card sidebar-late">
    <h3><span class="material-symbols-outlined" aria-hidden="true">military_tech</span> Contribuye a las Insignias</h3>
    <div class="badges-mini">
      {% for rawBadge in activity_badges %}
        {% set badgeId = rawBadge.id if rawBadge.id else (rawBadge | slugify) %}
        {% set badgeInfo = badgeId | badgeById(badges) %}
        {% set badgeLabel = badgeInfo.name if badgeInfo else ((rawBadge.name or rawBadge) | smartTitle) + ' (Actividades Generales)' %}
        <a href="{{ (badgeId | badgeHref(badges)) | url }}">
          <img
             src="{{ (badgeId | badgeLogo(badges)) | url }}"
                alt="{{ badgeLabel }}"   title="{{ badgeLabel }}" class="badge-large-icon">
       </a>
      {% endfor %}
    </div>
  </div>
  {% endif %}

</aside>




    {# COLUMNA CENTRAL #}

<main class="col-center">

<div class="content-card">
  <h2>
    <span class="material-symbols-outlined" aria-hidden="true">push_pin</span>
    Introducción
  </h2>

  <div class="markdown-content">
    <p>{{ summary or description }}</p>
  </div>
</div>


  {% set sections = content | splitBySections %}
  {% if sections | length %}
    {# Si el filtro encuentra secciones, las mostramos cada una en su card #}
    {% for section in sections %}

         {% set sectionClass = "" %}
         {% set sectionIcon = "article" %}
         {% set isTimeline = false %}
         {% set sectionMostrar = true %}
         {% set sectionColapsable = false %}


         {% if section.heading == "Resumen" %}
            {% set sectionClass = "timeline-summary" %}
            {% set sectionIcon = "checklist" %}
            {% set isTimeline = true %}
         {% endif %}

         {% if section.heading == "Preparación" or section.heading == "Preparacion" %}
            {% set sectionClass = "timeline-preparation" %}
            {% set sectionIcon = "inventory_2" %}
            {% set isTimeline = true %}
         {% endif %}

         {% if section.heading == "Desarrollo" %}
            {% set sectionClass = "timeline-development" %}
            {% set sectionIcon = "groups" %}
            {% set isTimeline = true %}
         {% endif %}

         {% if section.heading == "Cierre" %}
            {% set sectionClass = "timeline-closing" %}
            {% set sectionIcon = "psychology" %}
            {% set isTimeline = true %}
         {% endif %}


         {% if section.heading == "Texto original completo de la actividad" %}
            {% set sectionClass = "timeline-closing" %}
            {% set sectionMostrar = false %}
            {% set sectionColapsable = true %}
         {% endif %}


         {% if section.heading == "Checklist de verificación" %}
            {% set sectionClass = "timeline-closing" %}
            {% set sectionMostrar = false %}
            {% set sectionColapsable = true %}
         {% endif %}

         {% if sectionMostrar %}

              {% if isTimeline %}
                {% if sectionColapsable %}
                    {% set dtitle=section.heading %}
                    {% set dicon="{{ sectionIcon }}" %}
                    {% set dtype="info" %}
                    {% set dcontent %}

                       <div class="timeline-column">
                          <div class="timeline-line"></div>
                          <div class="timeline-circle">
                            <span class="material-symbols-outlined" aria-hidden="true">
                              {{ sectionIcon }}
                            </span>
                          </div>
                       </div>
                       <div class="timeline-content">
                         <h2>
                            {{ section.heading }}
                         </h2>
                         <div class="markdown-content">
                            {{ section.content | safe }}
                         </div>
                       </div>

                  {% endset %}
                  {% include "components/disclosure.njk" %}
                {% else %}
           <div class="content-card {{ sectionClass }} {% if isTimeline %}timeline-card{% endif %}">


                   <div class="timeline-column">
                      <div class="timeline-line"></div>
                      <div class="timeline-circle">
                        <span class="material-symbols-outlined" aria-hidden="true">
                          {{ sectionIcon }}
                        </span>
                      </div>
                   </div>
                   <div class="timeline-content">
                     <h2>
                        {{ section.heading }}
                     </h2>
                     <div class="markdown-content">
                        {{ section.content | safe }}
                     </div>
                   </div>
                </div>
                {% endif %}
              {% else %}
                {% set dtitle=section.heading %}
                {% set dicon=sectionIcon %}
                {% set dtype="info" %}
                {% set dcontent %}

                   <div class="markdown-content">
                      {{ section.content | safe }}
                   </div>

                {% endset %}

                {% include "components/disclosure.njk" %}


              {% endif %}

           

        {% endif %}

    {% endfor %}
  {% else %}
    {# Fallback: mostrar el contenido original sin dividir (para que no desaparezca) #}
    <div class="content-card">
        <h2>📄 Contenido completo</h2>
        {{ content | safe }}
    </div>
  {% endif %}
</main>



    {# COLUMNA DERECHA #}
    <aside class="col-right">

{% set competenciasData = (competencias or [])[0].ramas %}

{# Programa Scout: primero las ramas de age_group; las demás
   ramas que tengan competencias cargadas quedan plegadas en
   "Mostrar otras ramas", por si un educador usa la actividad
   fuera del rango ideal. #}
{% set ramasPrograma = [
  { id: "castores",     name: "Castores",     href: "/edades/castores/",     img: "castores",     field: "rama_castores" },
  { id: "manada",       name: "Manada",       href: "/edades/manada/",       img: "manada",       field: "rama_lobatos",    pill: "lobatos",    data: "manada",     label: "Rastro",      cat: "Sendero" },
  { id: "unidad-scout", name: "Unidad Scout", href: "/edades/unidad-scout/", img: "unidad-scout", field: "rama_scouts",     pill: "scouts",     data: "scouts",     label: "Competencia", cat: "Categoría" },
  { id: "caminantes",   name: "Caminantes",   href: "/edades/caminantes/",   img: "caminantes",   field: "rama_caminantes", pill: "caminantes", data: "caminantes", label: "Competencia", cat: "Categoría" },
  { id: "rovers",       name: "Rovers",       href: "/edades/rovers/",       img: "rovers",       field: "rama_rovers",     pill: "rovers",     data: "rovers",     label: "Competencia", cat: "Ruta" }
] %}
{% set ramaValores = {
  rama_castores: rama_castores,
  rama_lobatos: rama_lobatos,
  rama_scouts: rama_scouts,
  rama_caminantes: rama_caminantes,
  rama_rovers: rama_rovers
} %}

{% set ramasActividad = [] %}
{% for g in (age_group | default([])) %}
  {% set grupo = g | normalizeAge(ageGroups) %}
  {% if ramasActividad.push(grupo.id if grupo else g) %}{% endif %}
{% endfor %}

{% set ramasPropias = [] %}
{% set ramasOtras = [] %}
{% for r in ramasPrograma %}
  {% if r.id in ramasActividad %}
    {% if ramasPropias.push(r) %}{% endif %}
  {% elif ramaValores[r.field] and (ramaValores[r.field] | length) %}
    {% if ramasOtras.push(r) %}{% endif %}
  {% endif %}
{% endfor %}

{% macro ramaPrograma(r, valores, compsRama) %}
<div class="branch-item">
  <a href="{{ r.href | url }}" title="Ver actividades de {{ r.name }}">
    <img src="{{ ('/imagenes/ramas/' + r.img + '.png') | thumb("rama") | url }}" alt="{{ r.name }}">
  </a>
  <div class="branch-content">
    <div class="branch-name">{{ r.name }}</div>
    {% if valores and (valores | length) %}
      {% if r.pill %}
      <div class="competencias-pills">
        {% for numero in valores %}
          <span class="competencia-pill {{ r.pill }}" title="{% for comp in (compsRama or []) %}{% if comp.numero == numero %}{{ r.label }} {{ numero }}
{{ r.cat }}: {{ comp.ruta if r.cat == 'Ruta' else comp.categoria }}

{{ comp.descripcion }}{% endif %}{% endfor %}">{{ numero }}</span>
        {% endfor %}
      </div>
      {% else %}
      <div class="branch-actions">Acciones: {{ valores | join(", ") }}</div>
      {% endif %}
    {% endif %}
  </div>
</div>
{% endmacro %}

<div class="info-card">
  <h3>
    <span class="material-symbols-outlined" aria-hidden="true">groups</span>
    Programa Scout
  </h3>

  <div class="branch-grid">
    {% for r in ramasPropias %}
      {{ ramaPrograma(r, ramaValores[r.field], competenciasData[r.data] if r.data) }}
    {% endfor %}
  </div>

  {% if ramasOtras | length %}
  <details class="branch-others">
    <summary>Mostrar otras ramas ({{ ramasOtras | length }})</summary>
    <p class="branch-others-note">Fuera del rango de edad ideal de la actividad, por si la querés adaptar.</p>
    <div class="branch-grid">
      {% for r in ramasOtras %}
        {{ ramaPrograma(r, ramaValores[r.field], competenciasData[r.data] if r.data) }}
      {% endfor %}
    </div>
  </details>
  {% endif %}

</div>


{% if scout_method %}
  <div class="info-card">
    <h3>
      <span class="material-symbols-outlined" aria-hidden="true">explore</span>
        Método Scout
    </h3>

    <ul class="method-list">
      {% for item in scout_method %}
        {% set href = item | taxonomyHref(scoutMethod, "/metodoScout/") %}
        <li>{% if href %}<a href="{{ href | url }}" title="Ver actividades con «{{ item }}»">{{ item }}</a>{% else %}{{ item }}{% endif %}</li>
      {% endfor %}
    </ul>
   </div>
{% endif %}

{% if scout_values %}
  <div class="info-card">
    <h3>
      <span class="material-symbols-outlined" aria-hidden="true">diversity_3</span>
        Valores Scout
    </h3>

    <ul class="method-list">
      {% for item in scout_values %}
        {% set href = item | taxonomyHref(scoutValues, "/valoresScout/") %}
        <li>{% if href %}<a href="{{ href | url }}" title="Ver actividades con «{{ item }}»">{{ item }}</a>{% else %}{{ item }}{% endif %}</li>
      {% endfor %}
    </ul>
   </div>
{% endif %}

      {% if skills %}
      <div class="info-card">
        <h3><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> Habilidades desarrolladas</h3>
        <ul class="competence-list">
          {% for skill in skills %}
            {% set href = skill | taxonomyHref(allskills, "/habilidades/") %}
            <li>{% if href %}<a href="{{ href | url }}" title="Ver actividades con «{{ skill }}»">{{ skill }}</a>{% else %}{{ skill }}{% endif %}</li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}


      {% if (files | default([])) | length %}
      <div class="info-card">
        <h3><span class="material-symbols-outlined" aria-hidden="true">attach_file</span> Descargas</h3>
        <div class="download-list">
          {% for file in files %}
            <a href="{{ file.filepath }}" class="download-item">
              📄 {{ file.caption }}
            </a>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {% if (link | default([])) | length %}
      <div class="info-card">
        <h3><span class="material-symbols-outlined" aria-hidden="true">link</span> Enlaces</h3>
        <div class="download-list">
          {% for l in link %}
            {% set lurl = l.url if (l.url.startsWith('http') or l.url.startsWith('mailto:')) else 'https://' + l.url %}
            <a href="{{ lurl }}" class="download-item" target="_blank" rel="noopener">
              🔗 {{ l.caption or l.url }}
            </a>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {% if (sister | default([])) | length %}
      <div class="info-card sister-card">
        <h3><span class="material-symbols-outlined" aria-hidden="true">diversity_1</span> Actividad hermana</h3>
        <p>Scouts for SDGs, de la Organización Mundial del Movimiento Scout, publica una actividad similar a esta, porque las dos se basan en el mismo material original:</p>
        <div class="download-list">
          {% for s in sister %}
            <a href="{{ s.url }}" class="download-item" target="_blank" rel="noopener" lang="en">
              🔗 {{ s.title }} <small>(sdgs.scout.org, en inglés)</small>
            </a>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {% if tags %}

      <div class="info-card">
        <h3><span class="material-symbols-outlined" aria-hidden="true">local_offer</span> Etiquetas</h3>
        <div class="tag-list">
          {% for tag in tags %}
              {% if tag not in ['actividades', 'recurso'] %}
                <a class="tag" href="{{ '/activities/' | url }}?etiqueta={{ tag | string | slugify }}" title="Ver actividades con la etiqueta «{{ tag }}»">{{ tag }}</a>
              {% endif %}
          {% endfor %}
        </div>
      </div>
      {% endif %}
    </aside>

  </div>




  {# ===== FILA INFERIOR DE INFORMACIÓN ===== #}
  <div class="info-row">

    {% if responsible or prep_time or accessibility %}
      <div class="info-card requirements-card">
        <h3><span class="material-symbols-outlined" aria-hidden="true">assignment_ind</span> Responsable / requisitos</h3>
        <p><strong>Responsable:</strong> {{ responsible }}</p>
        {% if prep_time %}<p><strong>Tiempo preparación:</strong> {{ prep_time }}</p>{% endif %}
{#        {% if accessibility %}<p><strong>Accesibilidad:</strong> {{ accessibility |  default([]) | join(", ") }}</p>{% endif %} #}
      </div>
    {% endif %}


    {% if author or source or license or adapted_from or translator or credits %}
      <div class="info-card credits-card">
        <h3>
          <span class="material-symbols-outlined" aria-hidden="true">license</span>
             Créditos
        </h3>
        {% if author %}
           <p>
             <strong>Autor:</strong>
                {{ author | join(", ") }}
           </p>
        {% endif %}
        {% if source %}
          <p>
            <strong>Fuente:</strong>
               {{ source | join(", ") }}
          </p>
        {% endif %}
        {% if adapted_from %}
          <p>
            <strong>Adaptado de:</strong>
              {{ adapted_from }}
            </p>
        {% endif %}
        {% if translator %}
          <p>
            <strong>Traducción:</strong>
              {{ translator }}
          </p>
        {% endif %}
        {% if credits %}
          <p>
            <strong>Créditos:</strong>
              {{ credits }}
          </p>
        {% endif %}
        {% if license %}
          <div class="license-block">
            <p class="license-name">
              <strong>Licencia:</strong>
              <a href="{{ license.url }}">{{ license.name }}</a>
            </p>
            {% if license.image or license.note or license.allowed or license.pending %}
              <details class="license-details">
                <summary>{% if license.pending %}Permisos (hay autorizaciones pendientes){% else %}Detalle de la licencia{% endif %}</summary>
                {% if license.image %}
                  <img src="{{ license.image }}" alt="{{ license.name }}" class="license-image">
                {% endif %}
                {% if license.note %}
                  <p class="license-note">{{ license.note }}</p>
                {% endif %}
                {% if license.allowed %}
                  <p class="license-allowed"><strong>Autorizado:</strong> {{ license.allowed }}</p>
                {% endif %}
                {% if license.pending %}
                  <p class="license-pending"><strong>Sin autorización todavía:</strong> {{ license.pending }}</p>
                {% endif %}
              </details>
            {% endif %}
          </div>
        {% endif %}
        <script>window.addEventListener('beforeprint',function(){document.querySelectorAll('.license-details').forEach(function(d){d.open=true;});});</script>
        <p class="license-disclaimer">Esta actividad se ofrece como referencia. Quien la implementa es responsable de evaluar sus riesgos y adaptarla a su grupo. Ver el <a href="{{ '/aviso-legal/' | url }}">aviso legal</a>.</p>

      </div>
    {% endif %}



    {% if translation_notice %}
      <div class="info-card translation-card">
        <h3><span class="material-symbols-outlined" aria-hidden="true">translate</span> Nota sobre la traducción</h3>
        {% if translation_notice.en %}
           <p>{{ translation_notice.en }}</p>
        {% endif %}

        {% if translation_notice.es %}
          <p>{{ translation_notice.es }}</p>
        {% endif %}

        {% if references %}
          {% for ref in references %}
            {% if ref.url %}<p><strong>Versión original:</strong> <a href="{{ ref.url }}">{{ ref.title }}</a></p>{% endif %}
          {% endfor %}
        {% endif %}
      </div>

    {% endif %}



    {% if references %}
      <div class="info-card  references-card">
        <h3><span class="material-symbols-outlined" aria-hidden="true">menu_book</span> Referencias</h3>
        <ul>
          {% for ref in references %}
             <li>{% if ref.url %}<a href="{{ ref.url }}">{% endif %}<strong>{{ ref.title }}</strong> – {% if ref.author %}{{ ref.author }}{% endif %} {% if ref.year %}({{ ref.year }}){% endif %}{% if ref.url %}</a>{% endif %}</li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}

  </div>


{% set allActivities =
     collections.activitiesSorted %}

{% set currentIndex =
     page.url | activityIndex(allActivities) %}

{% set previousActivity =
     allActivities[currentIndex - 1] %}

{% set nextActivity =
     allActivities[currentIndex + 1] %}

<section class="activity-navigation">

  {% if previousActivity %}
  <a
    class="activity-nav-card previous"
    href="{{ previousActivity.url | url }}">

    <span class="nav-label">
      ← Actividad anterior
    </span>

    <strong>
      {{ previousActivity.data.title }}
    </strong>

  </a>
  {% endif %}

  {% if nextActivity %}
  <a
    class="activity-nav-card next"
    href="{{ nextActivity.url | url }}">

    <span class="nav-label">
      Actividad siguiente →
    </span>

    <strong>
      {{ nextActivity.data.title }}
    </strong>

  </a>
  {% endif %}

</section>



  {# ===== ACTIVIDADES RELACIONADAS ===== #}
{% set currentActivity =
     page.url | currentActivity(collections.activities) %}

{% set related =
     currentActivity
     | relatedActivities(collections.activities) %}
<section class="related-section">

<h2>También te puede gustar</h2>

<div class="related-carousel">

{% for rel in related %}

    {% set activity = rel.activity %}
    {% set item = activity.data %}
    {% set activityUrl = activity.url %}
    {% set layout = "compact" %}

    {% include "components/activity-card.njk" %}

{% endfor %}

</div>

</section>


  </div>


</article>


