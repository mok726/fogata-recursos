---
layout: layouts/base.njk
---

<article class="activity-page">

  <nav class="breadcrumbs">

<a href="{{ '/' | url }}">
      Inicio
    </a>

    <span>
      /
    </span>

<a href="{{ '/activities/' | url }}">
      Actividades
    </a>

    <span>
      /
    </span>

    <span>
     {{ title }}
    </span>

  </nav>
  {% set badge = null %}

  {% if activity_badges and activity_badges.length %}

    {% set rawBadge = activity_badges[0] %}

    {% if rawBadge.id %}

      {% set badge = rawBadge %}

    {% else %}

      {% set badge = {
        "id": rawBadge | slugify,
        "name": rawBadge
      } %}

    {% endif %}

  {% endif %}



<header class="activity-hero">

  {% set heroImage =
    image
    or '/imagenes/actividades/activity-card.png'
  %}

  <div class="activity-hero-banner">

    <img
      class="activity-hero-image"
      src="{{ heroImage | url }}"
      alt="{{ title }}">

    <div class="activity-hero-overlay"></div>

    {% if duration %}
      <div class="activity-hero-duration">
        ⏱ {{ duration }}
      </div>
    {% endif %}

    {% if age_group %}
      <div class="activity-hero-ages">

        {% for age in age_group %}

          {% set ageId = age | slugify %}
          {% set ageData = null %}

          {% for group in ageGroups %}
            {% if group.id == ageId %}
              {% set ageData = group %}
            {% endif %}
          {% endfor %}

          {% if ageData and ageData.icon %}
            <a href="{{ ('/edades/' + ageId + '/') | url }}">
              <img
                class="branch-icon"
                src="{{ ('/imagenes/ramas/' + ageData.icon) | url }}"
                alt="{{ ageData.name }}">
            </a>
          {% endif %}

        {% endfor %}

      </div>
    {% endif %}

    <div class="activity-hero-content">

      <h1>
        {{ title }}
      </h1>

{% if summary %}
  <p class="activity-description">
    {{ summary }}
  </p>

{% elseif description %}

  <p class="activity-description">
    {{ description }}
  </p>

{% endif %}

    </div>

    {% if sdgs %}
      <div class="activity-hero-sdgs">

        {% for sdg in sdgs %}

          <a href="{{ ('/ods/' + sdg + '/') | url }}">
            <img
              class="sdg-icon"
              src="{{ ('/imagenes/ods/ods-' + sdg + '.png') | url }}"
              alt="ODS {{ sdg }}">
          </a>

        {% endfor %}

      </div>
    {% endif %}

    <div class="activity-hero-bottom-right">

      {% if activity_badges %}

        <div class="activity-hero-badges">

          {% for rawBadge in activity_badges %}

            {% if rawBadge.id %}
              {% set badgeId = rawBadge.id %}
              {% set badgeName = rawBadge.name %}
            {% else %}
              {% set badgeId = rawBadge | slugify %}
              {% set badgeName = rawBadge %}
            {% endif %}

            <a href="{{ ('/badges/' + badgeId + '/') | url }}">
              <img
                class="badge-icon"
                src="{{ ('/imagenes/insignias/' + badgeId + '.png') | url }}"
                alt="{{ badgeName }}">
            </a>

          {% endfor %}

        </div>

      {% endif %}


    </div>


   {% if original %}
     <div class="activity-original-banner">
        Actividad original
     </div>
   {% endif %}


  </div>

</header>

{% if required %}

<section class="activity-required-box">

  <div class="required-header">

    <span class="required-icon">
      ⭐
    </span>

    <div>

      <h2>
        Actividad requerida
      </h2>

      <p>
        Esta actividad es obligatoria para completar las siguientes secciones de insignia.
      </p>

    </div>

  </div>

  <div class="required-badges">

    {% for req in required_for %}

      {% set badgeId = req | lower | replace('-a','') | replace('-b','') | replace('-c','')  | replace('-d','') | replace('-e','') | replace('-f','') %}
      {% set category = req | upper %}

      {% set sectionId = category %}


      <div class="required-badge-card">

        <img
          src="{{ ('/imagenes/insignias/' + badgeId + '.png') | url }}"
          alt="{{ badgeId }}">

        <div>

          <strong>
            {{ badgeId | capitalize }}
          </strong>

          <div class="required-section">

            Sección {{ sectionId | upper }}

          </div>

        </div>

      </div>

    {% endfor %}

  </div>

  {% if required_comment %}

    <div class="required-comment">

      {{ required_comment }}

    </div>

  {% endif %}

</section>

{% endif %}




<section class="activity-main-layout">

  <aside class="activity-sidebar">

    {% if duration or age_group %}

      <div class="sidebar-card">

        <h2>Ficha técnica</h2>

        {% if duration %}
          <p><strong>Duración:</strong> {{ duration }}</p>
        {% endif %}

        {% if age_group %}
          <p>
            <strong>Ramas:</strong><br>
            {{ age_group | join(", ") }}
          </p>
        {% endif %}

      </div>

    {% endif %}


    {% if materials %}

      <div class="sidebar-card">

        <h2>Materiales</h2>

        <ul>
          {% for item in materials %}
            <li>{{ item }}</li>
          {% endfor %}
        </ul>

      </div>

    {% endif %}

{% if tools %}
<div class="sidebar-card">

  <h2>Herramientas</h2>

  <ul>
    {% for item in tools %}
      <li>{{ item }}</li>
    {% endfor %}
  </ul>

</div>
{% endif %}

{% if competencies %}
<div class="sidebar-card">

  <h2>Competencias</h2>

  <ul>
    {% for item in competencies %}
      <li>{{ item }}</li>
    {% endfor %}
  </ul>

</div>
{% endif %}


    {% if educational_objectives %}

      <div class="sidebar-card">

        <h2>Objetivos educativos</h2>

        <ul>
          {% for item in educational_objectives %}
            <li>{{ item }}</li>
          {% endfor %}
        </ul>

      </div>

    {% endif %}


    {% if competencies %}

      <div class="sidebar-card">

        <h2>Competencias</h2>

        <ul>
          {% for item in competencies %}
            <li>{{ item }}</li>
          {% endfor %}
        </ul>

      </div>

    {% endif %}

    {% if responsible %}

      <div class="sidebar-card">

        <h2>Responsables</h2>

        {% if responsible is string %}

          <p>{{ responsible }}</p>

        {% else %}

          <ul>
            {% for item in responsible %}
              <li>{{ item }}</li>
            {% endfor %}
          </ul>

        {% endif %}

      </div>

    {% endif %}



{% if required %}
<div class="sidebar-card required-sidebar">

  <h2>Actividad requerida</h2>

  {% if required_category %}
    <p>
      Requerida para:
      <strong>{{ required_category }}</strong>
    </p>
  {% endif %}

  {% if required_comment %}
    <p>{{ required_comment }}</p>
  {% endif %}

</div>
{% endif %}


{% if files %}

<div class="sidebar-card">

  <h2>Archivos y recursos</h2>

  <div class="sidebar-files">

    {% for file in files %}

      <a
        class="sidebar-file"
        href="{{ file.filepath }}">

        <div class="sidebar-file-icon">

          {% if file.icon == "pdf" %}
            📄
          {% elseif file.icon == "imagen" %}
            🖼️
          {% else %}
            📦
          {% endif %}

        </div>

        <div class="sidebar-file-info">

          <strong>{{ file.icon | upper }}</strong>

          <div>
            {{ file.caption }}
          </div>

        </div>

      </a>

    {% endfor %}

  </div>

</div>

{% endif %}




  </aside>


<section class="activity-content">

  {{ content | safe }}

</section>

</section>



  {% if educational_objectives %}


      <h2>
        Objetivos educativos
      </h2>

      <ul>

        {% for item in educational_objectives %}

          <li>
            {{ item }}
          </li>

        {% endfor %}

      </ul>

    </section>

  {% endif %}











<footer class="activity-footer">


{% if references %}
<section class="footer-card">

  <h2>Referencias</h2>

  <ul>

    {% for ref in references %}

      <li>

        <strong>{{ ref.title }}</strong>

        {% if ref.author %}
          — {{ ref.author }}
        {% endif %}

        {% if ref.year %}
          ({{ ref.year }})
        {% endif %}

        {% if ref.series %}
          <br>{{ ref.series }}
        {% endif %}

        {% if ref.url %}
          <br>
          <a href="{{ ref.url }}">
            {{ ref.url }}
          </a>
        {% endif %}

      </li>

    {% endfor %}

  </ul>

</section>
{% endif %}



  {% if attributions %}

    <section class="footer-card">

      <h2>Atribuciones</h2>

      <ul>

        {% for item in attributions %}

          <li>

            <strong>{{ item.entity }}</strong>

            — {{ item.role }}

            {% if item.year %}
              ({{ item.year }})
            {% endif %}

          </li>

        {% endfor %}

      </ul>

    </section>

  {% endif %}





  {% if license %}

    <section class="footer-card">

      <h2>Licencia</h2>

      <div class="license-info">

        {% if license.image %}

          <img
            src="{{ license.image }}"
            alt="{{ license.name }}">

        {% endif %}

        <div>

          <strong>{{ license.name }}</strong>

          {% if license.url %}
            <br>

            <a
              href="{{ license.url }}"
              target="_blank">

              Ver licencia

            </a>

          {% endif %}

        </div>

      </div>

    </section>

  {% endif %}


{% if translation_notice %}
<section class="footer-card translation-card">

  <h2>Aviso de traducción</h2>

  {% if translation_notice.es %}
    <p>{{ translation_notice.es }}</p>
  {% endif %}

</section>
{% endif %}



  {% if source or author %}

    <section class="footer-card">

      <h2>Créditos</h2>

      <ul>

        {% if author %}
          <li>Autor: {{ author }}</li>
        {% endif %}

        {% if source %}
          <li>Fuente: {{ source }}</li>
        {% endif %}

      </ul>

    </section>

  {% endif %}

</footer>


<hr class="activity-end-divider">

{% set related = collections.activitiesSorted | reverse %}
<section class="related-section">

  <h2>
    También te puede interesar
  </h2>

  <div class="grid">

    {% for item in related %}

      {% if loop.index <= 4 %}

        {% if item.url != page.url %}

          {% set relatedActivity = item %}
          {% set item = relatedActivity.data %}
          {% set activityUrl = relatedActivity.url %}

          {% include "components/activity-card.njk" %}

        {% endif %}

      {% endif %}

    {% endfor %}

  </div>

</section>




</article>


