---
layout: layouts/base.njk

styles:
  - /css/cards.css


---



<div class="taxonomy-page">
{% set activityCount = 0 %}

{% for activity in collections.activitiesSorted %}

  {% if activity.data.activity_type %}

    {% if activityType.name in activity.data.activity_type %}
      {% set activityCount = activityCount + 1 %}
    {% endif %}

  {% endif %}

{% endfor %}

<section class="page-header">

  <div>

    <h1>
      {{ activityType.name }}
    </h1>

    <p>
      {{ activityCount }} actividades relacionadas.
    </p>

  </div>

</section>

<div class="grid">

  {% for activity in collections.activitiesSorted %}

    {% if activity.data.activity_type %}

      {% if activityType.name in activity.data.activity_type %}

        {% set item = activity.data %}
        {% set activityUrl = activity.url %}

        {% include "components/activity-card.njk" %}

      {% endif %}

    {% endif %}

  {% endfor %}

</div>

</div>
