---
layout: layouts/base.njk
---

<div class="badge-header">

  <img
    class="badge-logo"
src="{{ ('/imagenes/insignias/' + (badge_id | lower) + '.png') | url }}"
    alt="{{ title }}"
  >

  <div>

    <h1>{{ title }}</h1>

    <p>{{ description }}</p>

  </div>

</div>

<hr>

{{ content | safe }}

<hr>

<h2>Actividades relacionadas</h2>

<div class="card-grid">

{% for activity in collections.activities %}

  {% if activity.data.badges %}

    {% for badge in activity.data.badges %}

      {% if badge == badge_id %}

        <article class="card">

          <h3>
            <a href="{{ activity.url  | url }}">
              {{ activity.data.title }}
            </a>
          </h3>

          <p>{{ activity.data.description }}</p>

        </article>

      {% endif %}

    {% endfor %}

  {% endif %}

{% endfor %}

</div>


