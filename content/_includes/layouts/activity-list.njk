<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>{{ title }} - Fogata Recursos</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      margin: auto;
      max-width: 1200px;
      padding: 1rem;
      background: #f5f5f5;
      color: #222;
    }

    h1 {
      margin-bottom: 2rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1rem;
    }

    .card {
      background: white;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      transition: transform 0.2s;
    }

    .card:hover {
      transform: translateY(-3px);
    }

    .card-content {
      padding: 1rem;
    }

    .badge {
      width: 100%;
      height: 180px;
      object-fit: cover;
      background: #ddd;
    }

    .sdgs {
      display: flex;
      flex-wrap: wrap;
      gap: 0.3rem;
      margin-top: 1rem;
    }

    .sdgs img {
      width: 42px;
      border-radius: 4px;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    .meta {
      font-size: 0.9rem;
      color: #666;
      margin-top: 0.5rem;
    }
  </style>
</head>

<body>

<h1>{{ title }}</h1>

<div class="grid">

{% for activity in collections.activities %}

  <a href="{{ activity.url }}">

    <div class="card">

	{% if activity.data.badges %}
	
		{% set badge = activity.data.badges[0] %}

			{% if badge.id %}
			  {% set badgeId = badge.id %}
			  {% set badgeName = badge.name %}
			{% else %}
			  {% set badgeId = badge | slugify %}
			  {% set badgeName = badge %}
			{% endif %}

		<img
		  src="/imagenes/insignias/{{ badgeId }}.png"
		  alt="{{ badgeName }}"
		>
	{% endif %}

      <div class="card-content">

        <h2>{{ activity.data.title }}</h2>

        {% if activity.data.description %}
          <p>{{ activity.data.description }}</p>
        {% endif %}

        <div class="meta">

          {% if activity.data.age_group %}
            {{ activity.data.age_group | join(", ") }}
          {% endif %}

          {% if activity.data.duration %}
            • {{ activity.data.duration }}
          {% endif %}

        </div>

        <div class="sdgs">

          {% for sdg in activity.data.sdgs %}
            <img
              src="/imagenes/ods/ods-{{ sdg }}.png"
              alt="ODS {{ sdg }}">
          {% endfor %}

        </div>

      </div>

    </div>

  </a>

{% endfor %}

</div>

</body>
</html>


