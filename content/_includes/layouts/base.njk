<!DOCTYPE html>
<html lang="{{ site.language }}" data-base="{{ '/' | url }}">

<head>

<meta
  name="generator"
  content="Eleventy">

  <meta charset="UTF-8">

  {# Vista «docente» o «scout» (?modo=...): oculta lo que a cada uno
     no le sirve. No se guarda nada: el modo viaja en la dirección
     y se suma a los enlaces internos al hacer clic. #}
  <script>
  (function () {
    var m = new URLSearchParams(location.search).get('modo');
    if (m === 'docente' || m === 'scout') document.documentElement.setAttribute('data-modo', m);
  })();
  </script>

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0">

  {% set pageTitle %}
    {% if seo_title %}
      {{ seo_title }} - {{ site.name }}
    {% elif title %}
      {{ title }} - {{ site.name }}
    {% else %}
      {{ site.name }}
    {% endif %}
  {% endset %}

  {% set pageDescription %}
    {% if description %}
      {{ description }}
    {% else %}
      {{ site.description }}
    {% endif %}
  {% endset %}

  {# Al compartir una actividad se muestra su propia imagen
     (ver preset "og" en _data/thumbPresets.js). #}
  {% set ogImage = "/imagenes/social-preview.jpg" %}
  {% set ogType = "website" %}
  {% if image and (image | thumb("og")) != image %}
    {% set ogImage = image | thumb("og") %}
    {% set ogType = "article" %}
  {% endif %}

  {% set canonicalUrl %}
    {{ site.url }}{{ page.url | url }}
  {% endset %}

  <title>
    {{ pageTitle | trim }}
  </title>

  <meta
    name="description"
    content="{{ pageDescription | trim }}">

  <meta
    name="theme-color"
    content="#355b38">

  <meta
    name="author"
    content="{{ site.author }}">

  <link
    rel="canonical"
    href="{{ canonicalUrl | trim }}">

  <link rel="alternate" type="application/atom+xml"
    title="{{ site.name }}: actividades nuevas"
    href="{{ site.url }}{{ '/feed.xml' | url }}">
  <link rel="alternate" type="application/atom+xml"
    title="{{ site.name }}: actividad del día"
    href="{{ site.url }}{{ '/actividad-del-dia.xml' | url }}">

  {# Páginas internas o de prueba: front matter `noindex: true`. #}
  {% if noindex %}
  <meta name="robots" content="noindex, follow">
  {% endif %}

  {# Verificación de buscadores: completar en _data/site.js. #}
  {% if site.verification.google %}
  <meta name="google-site-verification" content="{{ site.verification.google }}">
  {% endif %}
  {% if site.verification.bing %}
  <meta name="msvalidate.01" content="{{ site.verification.bing }}">
  {% endif %}

  {% include "components/json-ld.njk" %}

	<!-- Favicon -->
  <link
    rel="icon"
    type="image/png"
    href="{{ '/imagenes/favicon-32.png' | url }}"  sizes="32x32">

  <link
    rel="icon"
    type="image/png"
    href="{{ '/imagenes/favicon-square-180x180.png' | url }}"  sizes="180x180">





  <!-- OpenGraph -->

  <meta
    property="og:type"
    content="{{ ogType }}">

  <meta
    property="og:site_name"
    content="{{ site.name }}">

  <meta
    property="og:title"
    content="{{ pageTitle | trim }}">

  <meta
    property="og:description"
    content="{{ pageDescription | trim }}">

  <meta
    property="og:url"
    content="{{ canonicalUrl | trim }}">

<meta property='og:locale' content='es_AR' />

<!-- Image to display -->

<meta
  property="og:image"
  content="{{ site.url }}{{ site.pathPrefix }}{{ ogImage }}">
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="{{ pageTitle | trim }}" />





 
<!-- No need to change anything here -->
<!-- meta property="og:image:type" content="image/jpeg" -->
  

<!-- MS, fb & Whatsapp -->

<!-- MS Tile - for Microsoft apps-->
<meta name="msapplication-TileImage" content="{{ site.url }}{{ site.pathPrefix }}/imagenes/favicon-square-270x270.png">    
<!-- meta name="msapplication-TileImage" content="{{ '/imagenes/favicon-square-270x270.png' | url }}" -->


<meta property="fb:admins" content="mscosentino"/>


  <link rel="apple-touch-icon-precomposed" href="{{ '/imagenes/favicon-square-180x180.png' | url }}">




<!--
put this inside the body 
<link itemprop="thumbnailUrl" href="url_image"> 
<span itemprop="thumbnail" itemscope itemtype="http://schema.org/ImageObject"> 
  <link itemprop="url" href="{{ site.url }}{{ site.pathPrefix }}/imagenes/social-card-small.png"> 
</span>
-->

<link itemprop="thumbnailUrl" href="{{ site.url }}{{ site.pathPrefix }}/imagenes/social-card-small.png"> 




  <!-- Twitter -->

  <meta
    name="twitter:card"
    content="summary_large_image">

  <meta
    name="twitter:title"
    content="{{ pageTitle | trim }}">

  <meta
    name="twitter:description"
    content="{{ pageDescription | trim }}">

<meta
  name="twitter:image"
  content="{{ site.url }}{{ site.pathPrefix }}{{ ogImage }}">

<meta name="twitter:image:alt" content="{{ pageTitle | trim }}" />
<!-- meta name="twitter:site" content="@MCTArgentina" / -->
<meta name="twitter:creator" content="@mok726">






  <!-- Performance -->

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com">

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin>


<!-- Google Fonts (text) – keep if you use it -->
<link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,600;14..32,700&display=swap" rel="stylesheet">

<!-- Google Material Symbols (icons) – add this -->
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0..1,0" rel="stylesheet">

{# Fuentes extra por página (front matter `fonts:`) #}
{% for font in fonts %}
<link href="{{ font }}" rel="stylesheet">
{% endfor %}





  <!-- CSS -->
{# ?v= cambia en cada build: así el navegador no mezcla CSS
   nuevo con CSS viejo de su caché después de un deploy. #}
{% set cssVersion = buildDate.getTime() %}
<link rel="stylesheet" href="{{ '/css/main.css' | url }}?v={{ cssVersion }}">
<link rel="stylesheet" href="{{ '/css/fogata.css' | url }}?v={{ cssVersion }}">



{% if styles %}
  {% for css in styles %}
<link rel="stylesheet" href="{{ css | url }}?v={{ cssVersion }}">
  {% endfor %}
{% endif %}




</head>

<body>

  {% include "components/scout-deco.njk" %}

  {% include "components/navbar.njk" %}

  <main class="page-container"{% if not nosearch %} data-pagefind-body{% endif %}>

    {% if prose %}
    <article class="page-content prose-page">
      {{ content | safe }}
    </article>
    <script>
      /* Tablas apilables en móvil: copia el encabezado a cada celda. */
      document.querySelectorAll('.prose-page table').forEach(function (t) {
        var heads = Array.prototype.map.call(t.querySelectorAll('thead th'), function (th) { return th.textContent.trim(); });
        if (!heads.length) return;
        t.querySelectorAll('tbody tr').forEach(function (tr) {
          Array.prototype.forEach.call(tr.children, function (td, i) { td.setAttribute('data-label', heads[i] || ''); });
        });
        t.classList.add('stacked');
      });
    </script>
    {% else %}
    {{ content | safe }}
    {% endif %}

  </main>

  {% include "components/footer.njk" %}

  {# Volver arriba: oculto hasta bajar una pantalla. Lleva el foco
     al principio de la página para que el teclado siga desde ahí. #}
  <button type="button" class="volver-arriba" id="volver-arriba" hidden
    aria-label="Volver arriba" title="Volver arriba">
    <span class="material-symbols-outlined" aria-hidden="true">arrow_upward</span>
  </button>
  <script>
  (function () {
    var b = document.getElementById('volver-arriba');
    if (!b || !window.addEventListener) return;
    var pendiente = false;
    function revisar() {
      pendiente = false;
      b.hidden = window.scrollY < window.innerHeight;
    }
    window.addEventListener('scroll', function () {
      if (!pendiente) { pendiente = true; window.requestAnimationFrame(revisar); }
    }, { passive: true });
    revisar();
    b.addEventListener('click', function () {
      var quieto = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: quieto ? 'auto' : 'smooth' });
      document.body.setAttribute('tabindex', '-1');
      document.body.focus({ preventScroll: true });
      document.body.removeAttribute('tabindex');
    });
  })();
  </script>

  <script>
  (function () {
    function sumarModo(e) {
      var modo = document.documentElement.getAttribute('data-modo');
      if (!modo) return;
      var a = e.target.closest && e.target.closest('a[href]');
      if (!a || a.hasAttribute('data-modo-salir')) return;
      var url;
      try { url = new URL(a.href, location.href); } catch (err) { return; }
      if (url.origin !== location.origin || url.searchParams.has('modo')) return;
      if (url.pathname === location.pathname && url.hash && !url.search) return;
      url.searchParams.set('modo', modo);
      a.href = url.toString();
    }
    document.addEventListener('mousedown', sumarModo, true);
    document.addEventListener('click', sumarModo, true);
  })();
  </script>

  {# Migas de pan de las actividades según el origen (js/migas.js). #}
  <script src="{{ '/js/migas.js' | url }}?v={{ cssVersion }}"></script>

  <script
    src="{{ '/pagefind/pagefind-ui.js' | url }}">
  </script>


<span itemprop="thumbnail" itemscope itemtype="http://schema.org/ImageObject"> 
  <link itemprop="url" href="{{ site.url }}{{ site.pathPrefix }}/imagenes/social-card-small.png"> 
</span>




</body>

</html>
