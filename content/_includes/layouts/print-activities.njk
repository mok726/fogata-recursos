<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="utf-8">

  {# Vista «docente» o «scout» (?modo=...), igual que en el resto del sitio. #}
  <script>
  (function () {
    var m = new URLSearchParams(location.search).get('modo');
    if (m === 'docente' || m === 'scout') document.documentElement.setAttribute('data-modo', m);
  })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ activity.data.title }}</title>

  {# Versión imprimible: los buscadores deben indexar la ficha normal. #}
  <link rel="canonical" href="{{ site.url }}{{ activity.url | url }}">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@500;700&family=Inter:opsz,wght@14..32,400;14..32,600;14..32,700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">

  <link rel="stylesheet" href="{{ '/css/components/print.css' | url }}?v={{ buildDate.getTime() }}">
</head>

<body>

{% set d = activity.data %}

{# El encabezado se repite en cada hoja (thead). El pie lo pone el
   navegador (fecha, URL y número de página). #}
<table class="print-document">
  <thead>
    <tr><td>
      <header class="print-header">
        <div class="ph-marca">
          <img src="{{ '/imagenes/favicon.png' | url }}" class="ph-logo" alt="">
          <span>{{ site.name }}</span>
        </div>
        <div class="ph-ficha">
          {% if d.activity_code %}<span>{{ d.activity_code }}</span>{% endif %}
          {% if d.version %}<span>v{% if d.version | isDraft %} borrador{% else %}{{ d.version }}{% endif %}</span>{% endif %}
        </div>
      </header>
    </td></tr>
  </thead>

  <tbody>
    <tr><td>
<main class="print-main">

  <section class="pf-titulo">
    <h1>{{ d.title }}</h1>
    {% if d.summary %}<p class="pf-bajada">{{ d.summary }}</p>{% endif %}
  </section>

  {# ---------- Datos rápidos ---------- #}
  <section class="pf-datos">
    <div class="pf-chips">
      {% if d.duration %}
      <div class="pf-chip"><span class="material-symbols-outlined" aria-hidden="true">schedule</span>
        <div><span class="pf-chip-et">Duración</span>{{ d.duration }}{% if d.duration_detail %}<small>{{ d.duration_detail }}</small>{% endif %}</div></div>
      {% endif %}
      {% if d.age_group %}
      <div class="pf-chip"><span class="material-symbols-outlined" aria-hidden="true">cake</span>
        <div><span class="pf-chip-et">Edades</span>{{ d.age_group | ageRange }}</div></div>
      {% endif %}
      {% if d.participants %}
      <div class="pf-chip"><span class="material-symbols-outlined" aria-hidden="true">groups</span>
        <div><span class="pf-chip-et">Participantes</span>{{ d.participants }}</div></div>
      {% endif %}
      {% if d.location %}
      <div class="pf-chip"><span class="material-symbols-outlined" aria-hidden="true">share_location</span>
        <div><span class="pf-chip-et">Lugar</span>{{ d.location }}{% if d.location_detail %}<small>{{ d.location_detail }}</small>{% endif %}</div></div>
      {% endif %}
    </div>

    {% set niveles = [
      ["Ejecución", d.complexity_execution],
      ["Organización", d.complexity_organizer],
      ["Lúdico", d.ludic_component],
      ["Reflexivo", d.reflective_component],
      ["Activo", d.active_component]
    ] %}
    <div class="pf-niveles">
      {% for n in niveles %}{% if n[1] %}
      <div class="pf-nivel">
        <span class="pf-nivel-et">{{ n[0] }}</span>
        <span class="pf-puntos" aria-label="{{ n[1] }} de 5">{% for k in range(1, 6) %}<i class="{{ 'on' if k <= n[1] else '' }}"></i>{% endfor %}</span>
      </div>
      {% endif %}{% endfor %}
    </div>
  </section>

  {# ---------- Para qué sirve ---------- #}
    <section class="pf-programa">

      {% if d.skills %}
      <div class="pf-caja">
        <h2 class="pf-caja-tit">Habilidades</h2>
        <ul>{% for item in d.skills %}<li>{{ item }}</li>{% endfor %}</ul>
      </div>
      {% endif %}

      {% if d.scout_method %}
      <div class="pf-caja" data-modo-scout>
        <h2 class="pf-caja-tit">Método Scout</h2>
        <ul>{% for item in d.scout_method %}<li>{{ item }}</li>{% endfor %}</ul>
      </div>
      {% endif %}

      {% if d.scout_values %}
      <div class="pf-caja" data-modo-scout>
        <h2 class="pf-caja-tit">Valores Scout</h2>
        <ul>{% for item in d.scout_values %}<li>{{ item }}</li>{% endfor %}</ul>
      </div>
      {% endif %}

      {% if d.activity_badges or d.sdgs %}
      <div class="pf-caja">
        {% if d.activity_badges %}
        <h2 class="pf-caja-tit">Insignias</h2>
        <div class="icon-grid">
          {% for rawBadge in d.activity_badges %}
          {% set badgeId = rawBadge.id if rawBadge.id else (rawBadge | slugify) %}
          {% set badgeInfo = badgeId | badgeById(badges) %}
          <img src="{{ (badgeId | badgeLogo(badges)) | url }}"
               alt="{{ badgeInfo.name if badgeInfo else 'Actividades Generales' }}"
               title="{{ badgeInfo.name if badgeInfo else 'Actividades Generales' }}" class="badge-icon">
          {% endfor %}
        </div>
        {% endif %}
        {% if d.sdgs %}
        <h2 class="pf-caja-tit">ODS</h2>
        <div class="icon-grid">
          {% for item in d.sdgs %}
          <img src="{{ ('/imagenes/ods/ods-' + item + '.png') | url }}" class="ods-icon" alt="ODS {{ item }}">
          {% endfor %}
        </div>
        {% endif %}
      </div>
      {% endif %}

    </section>

  {% if d.materials %}
  <section class="pf-caja pf-materiales">
    <h2 class="pf-caja-tit"><span class="material-symbols-outlined" aria-hidden="true">inventory_2</span> Materiales</h2>
    <ul>
    {% for item in d.materials %}<li>{{ item }}</li>{% endfor %}
    </ul>
  </section>
  {% endif %}

  {# ---------- Desarrollo ---------- #}
  <section class="print-content">
    {% set sections = activity.templateContent | splitBySections %}

    {% for section in sections %}
      {% set sectionMostrar = true %}

      {% if sectionMostrar.heading == "Resumen" or  section.heading == "Texto original completo de la actividad" or section.heading == "Checklist de verificación"  or  section.heading == "Créditos"  or  section.heading == "Atribuciones"  or  section.heading == "Licencia"  or  section.heading == "Referencias"  or  section.heading == "Recursos descargables"%}
		{% set sectionMostrar = false %}
      {% endif %}

      {% if sectionMostrar %}

      <section class="print-section">

        <h2>{{ section.heading }}</h2>

        {{ section.content | safe }}

      </section>

      {% endif %}

    {% endfor %}
  </section>

  {# ---------- Enlace a la ficha completa ---------- #}
  <section class="pf-pie">
    <div class="pf-online">
      {% if activity.fileSlug %}
      <img src="{{ '/imagenes/actividades/qr/' | url }}{{ activity.fileSlug }}.png" class="activity-qr" alt="QR de la ficha">
      {% endif %}
      <div>
        <strong>Ficha completa en línea</strong>
        <p>Recursos descargables, créditos, atribuciones, licencia e información adicional.</p>
        <p class="qr-url">{{ site.url }}{{ activity.url | url }}</p>
        <p class="pf-impreso">Impreso el <span id="print-date"></span>{% if d.version %} · versión {% if d.version | isDraft %}borrador{% else %}{{ d.version }}{% endif %}{% endif %}</p>
      </div>
    </div>
  </section>

</main>
    </td></tr>
  </tbody>
</table>

<script>
document.getElementById("print-date").textContent =
  new Date().toLocaleDateString("es-AR");
</script>

</body>
</html>
