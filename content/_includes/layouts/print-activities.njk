<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="utf-8">

  <title>{{ activity.data.title }}</title>



<!-- Google Fonts (text) – keep if you use it -->
<link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,600;14..32,700&display=swap" rel="stylesheet">

<!-- Google Material Symbols (icons) – add this -->
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">



<!--
<script src="https://unpkg.com/pagedjs/dist/paged.polyfill.js"></script>
-->

  <link rel="stylesheet" href="{{ '/css/components/print.css' | url }}">
</head>

<body>

<table class="print-document">

  <thead>

    <tr>
      <td>



<header class="print-header">

  <img
    src="{{ '/imagenes/favicon.png' | url }}"
    class="header-logo"
    alt="Fogata">

  <div class="header-center">
    {{ site.name }}
  </div>

  <img
    src="{{ '/imagenes/favicon.png' | url }}"
    class="header-logo"
    alt="Fogata">

</header>



<div class="header-line"></div>

      </td>
    </tr>

  </thead>

  <tbody>

    <tr>
      <td>


<main class="print-page">


<aside class="print-sidebar">

  <div class="sidebar-box">

    <div class="sidebar-section">

  <h3>Ficha Tecnica</h3>


      {% if activity.data.duration %}
      <div class="meta-item">
        <span class="material-symbols-outlined" style="margin-right: 8px; vertical-align: middle;">schedule</span>  {{ activity.data.duration  or "N/E" }}
      </div>
      {% endif %}

      {% if activity.data.age_group %}
      <div class="meta-item">
          <span class="material-symbols-outlined" style="margin-right: 8px; vertical-align: middle;">productivity</span>  {{ activity.data.age_group | ageRange }}
      </div>
      {% endif %}

      {% if activity.data.participants %}
       <div class="meta-item">
        <span><span class="material-symbols-outlined" style="margin-right: 8px; vertical-align: middle;">groups</span>  {{ activity.data.participants or "N/E" }}</span>
      </div>
    {% endif %}


      {% if activity.data.location %}
       <div class="meta-item">
          <span class="material-symbols-outlined" style="margin-right: 8px; vertical-align: middle;">share_location</span>  {{ activity.data.location }}
      </div>
     {% endif %}


  {% if activity.data.complexity_execution %}
  <div class="meta-item">
    <div class="meta-label">Ejecucion:</div>
    <div class="meta-value">
      {{ "★".repeat(activity.data.complexity_execution) }}
    </div>
  </div>
  {% endif %}

  {% if activity.data.complexity_organizer %}
  <div class="meta-item">
    <div class="meta-label">Organizacion:</div>
    <div class="meta-value">
      {{ "★".repeat(activity.data.complexity_organizer) }}
    </div>
  </div>
  {% endif %}

  {% if activity.data.ludic_component %}
  <div class="meta-item">
    <div class="meta-label">Ludico:</div>
    <div class="meta-value">
      {{ "★".repeat(activity.data.ludic_component) }}
    </div>
  </div>
  {% endif %}

  {% if activity.data.reflective_component %}
  <div class="meta-item">
    <div class="meta-label">Reflexivo:</div>
    <div class="meta-value">
      {{ "★".repeat(activity.data.reflective_component) }}
    </div>
  </div>
  {% endif %}

  {% if activity.data.active_component %}
  <div class="meta-item">
    <div class="meta-label">Activo:</div>
    <div class="meta-value">
      {{ "★".repeat(activity.data.active_component) }}
    </div>
  </div>
  {% endif %}



<!--
  {% if activity.data.branch %}
  <div class="meta-item">
    <div class="meta-label"> ^area:</div>
    <div class="meta-value">
      {{ activity.data.branch | join(", ") }}
    </div>
  </div>
  {% endif %}
-->

  {% if activity.data.prep_time %}
  <div class="meta-item">
    <div class="meta-label">Preparacion:</div>
    <div class="meta-value">
      {{ activity.data.prep_time }}
    </div>
  </div>
  {% endif %}

  {% if activity.data.space_required %}
  <div class="meta-item">
    <div class="meta-label">Espacio:</div>
    <div class="meta-value">
      {{ activity.data.space_required }}
    </div>
  </div>
  {% endif %}




  {% if activity.data.activity_code %}
  <div class="meta-item">
    <div class="meta-label">ID:</div>
    <div class="meta-value">
      {{ activity.data.activity_code }}
    </div>
  </div>
  {% endif %}

  {% if activity.data.version %}
  <div class="meta-item">
    <div class="meta-label">Version:</div>
    <div class="meta-value">
      {% if activity.data.version == "DRAFT" %}
        BORRADOR
      {% else %}
        {{ activity.data.version }}
      {% endif %}
    </div>
  </div>
  {% endif %}



<!--
  <div class="meta-item">
    <div class="meta-label">Creado:</div>
    <div class="meta-value">
    </div>
  </div>
-->
  <div class="meta-item">
    <div class="meta-label">Impreso:</div>
    <div class="meta-value">
      <span id="print-date"></span>
    </div>
  </div>





    </div>

    {% if activity.data.materials %}
    <div class="sidebar-section">
      <h3>Materiales</h3>
      <ul>
      {% for item in activity.data.materials %}
        <li>{{ item }}</li>
      {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% if activity.data.skills %}
    <div class="sidebar-section">
      <h3>Competencias</h3>
      <ul>
      {% for item in activity.data.skills %}
        <li>{{ item }}</li>
      {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% if activity.data.activity_badges %}
    <div class="sidebar-section">
      <h3>Insignias</h3>

      <div class="icon-grid">

        {% for rawBadge in activity.data.activity_badges %}
        {% set badgeId = rawBadge.id if rawBadge.id else (rawBadge | slugify) %}
        {% set badgeInfo = badgeId | badgeById(badges) %}
          <img 
             src="{{
             (
                badgeInfo.logo
                if badgeInfo and badgeInfo.logo
                else '/imagenes/insignias/' + badgeId + '.png'
              ) | url 
            }}" 
                alt="{{ badgeInfo.name }}"   title="{{ badgeInfo.name }}" class="badge-icon">
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if activity.data.sdgs %}
    <div class="sidebar-section">
      <h3>ODS</h3>
       <div class="icon-grid">
        {% for item in activity.data.sdgs %}
          <img
            src="{{ ('/imagenes/ods/ods-' + item + '.png') | url }}"
            class="ods-icon"
            alt="ODS {{ item }}">
        {% endfor %}
      </div>    
    </div>
    {% endif %}



{% if
    activity.data.scout_method or
    activity.data.scout_values or
    activity.data.prep_time or
    activity.data.space_required
%}

<div class="sidebar-section">

  {% if activity.data.scout_method %}
    <div class="sidebar-section">
      <h3>M  todo Scout</h3>
      <ul>
      {% for item in activity.data.scout_method %}
        <li>{{ item }}</li>
      {% endfor %}
      </ul>
    </div>
  {% endif %}

  {% if activity.data.scout_values %}
    <div class="sidebar-section">
      <h3>Valores Scout</h3>
      <ul>
      {% for item in activity.data.scout_values %}
        <li>{{ item }}</li>
      {% endfor %}
      </ul>
    </div>
  {% endif %}




</div>



  {% endif %}






{% if activity.fileSlug %}
<div class="sidebar-section">

  <h3>Ver online</h3>

  <img
    src="{{ '/imagenes/actividades/qr/' | url }}{{ activity.fileSlug }}.png"
    class="activity-qr"
    alt="QR de la actividad">

  <div class="qr-url">
    {{ site.url }}{{ activity.url | url }}
  </div>

</div>
{% endif %}

  </div>

</aside>


  <section class="print-content">

    <h1>{{ activity.data.title }}</h1>

    {% if activity.data.summary %}
    <div class="activity-summary">
      {{ activity.data.summary }}
    </div>
    {% endif %}

    {% set sections = activity.templateContent | splitBySections %}

    {% for section in sections %}

      {% if section.heading != "Resumen" %}

      <section class="print-section">

        <h2>{{ section.heading }}</h2>

        {{ section.content | safe }}

      </section>

      {% endif %}

    {% endfor %}

    {% if activity.data.references %}
    <section class="print-section">

      <h2>Referencias</h2>

      <ul>

      {% for ref in activity.data.references %}
        <li>

          <strong>{{ ref.title }}</strong>

          {% if ref.author %}
          — {{ ref.author }}
          {% endif %}

          {% if ref.url %}
          <br>
          {{ ref.url }}
          {% endif %}

        </li>
      {% endfor %}

      </ul>

    </section>
    {% endif %}


{% if activity.data.files %}
<section class="print-section">

  <h2>Recursos descargables</h2>

  <div class="resource-list">

  {% for file in activity.data.files %}

    <div class="resource-card">

      <div class="resource-title">

        {% if file.icon == "pdf" %}
        📄
        {% elseif file.icon == "doc" %}
        📝
        {% elseif file.icon == "xls" %}
        📊
        {% else %}
        📎
        {% endif %}

        {{ file.caption }}

      </div>
      {% if file.filepath %}
      <div class="resource-url">
        {{ file.filepath }}
      </div>
      {% endif %}

    </div>

  {% endfor %}

  </div>

</section>
{% endif %}




{% if activity.data.author or activity.data.source %}

<section class="print-section credits-section">

  <h2>Créditos</h2>

  {% if activity.data.author %}

    <h3>Autoría</h3>

    <ul>
    {% for item in activity.data.author %}
      <li>{{ item }}</li>
    {% endfor %}
    </ul>

  {% endif %}

  {% if activity.data.source %}

    <h3>Fuentes</h3>

    <ul>
    {% for item in activity.data.source %}
      <li>{{ item }}</li>
    {% endfor %}
    </ul>

  {% endif %}

</section>

{% endif %}



{% if activity.data.license %}

<section class="print-section">

  <h2>Licencia</h2>
  <table> <tr><td>
  {% if activity.data.license.image %}

    <img
      src="{{ activity.data.license.image }}"
      alt="{{ activity.data.license.name }}"
      class="license-image">

  {% endif %}
  </td><td>

    <strong>{{ activity.data.license.name }}</strong>

    {% if activity.data.license.url %}
      <br>
      {{ activity.data.license.url }}
    {% endif %}
   </td></tr> </table>


</section>

{% endif %}

{% if activity.data.attributions %}

<section class="print-section">

  <h2>Atribuciones</h2>

  <ul>

  {% for item in activity.data.attributions %}

    <li>

      <strong>{{ item.entity }}</strong>

      {% if item.role %}
        — {{ item.role }}
      {% endif %}

      {% if item.year %}
        ({{ item.year }})
      {% endif %}

    </li>

  {% endfor %}

  </ul>

</section>

{% endif %}


{% if activity.data.translation_notice %}

<section class="print-section">

  <h2>Aviso de traducción</h2>

  {% if activity.data.translation_notice.es %}
    <p>{{ activity.data.translation_notice.es }}</p>
  {% endif %}

</section>

{% endif %}







</section>


</main>

      </td>
    </tr>

  </tbody>

  <tfoot>

    <tr>
      <td>


<footer class="print-footer">

  <div>
    {{ activity.fullUrl or (site.url + activity.url) }}
  </div>

  <div class="page-counter">
    Página    /   
  </div>

</footer>

      </td>
    </tr>

  </tfoot>

</table>

<script>
document.getElementById("print-date").textContent =
  new Date().toLocaleDateString("es-AR");
</script>

</html>


