{% macro render(card) %}

{% set activity = card.activity %}
{% set item = card.item %}
{% set activityUrl = card.url %}

{% set isRequired = card.isRequired or false %}
{% set isComplementary = card.isComplementary or false %}
{% set isFeatured = card.isFeatured or false %}

<div class="card activity-card {% if isRequired %}activity-card-required{% endif %} {% if isFeatured %}activity-card-featured{% endif %} {% if item.original %}activity-card-original{% endif %}">

  <div class="activity-card-hero">

    <a
      class="activity-card-main-link"
      href="{{ activityUrl | url }}">

      {% set activityImage =
        item.image
        or '/imagenes/actividades/activity-card.png'
      %}

      <img
        class="activity-card-image"
        src="{{ activityImage | url }}"
        alt="{{ item.title }}">

    </a>

    {% if item.original %}
      <div class="activity-original">
        <span class="material-symbols-outlined">
          stars
        </span>
      </div>
    {% endif %}

    {% if item.duration %}
      <div class="activity-duration">
        <span class="material-symbols-outlined">
          schedule
        </span>
        {{ item.duration }}
      </div>
    {% endif %}

    {% if isRequired %}
      <div class="activity-required">
        🏅 Obligatoria
      </div>
    {% endif %}

    {% if isComplementary %}
      <div class="activity-complementary">
        COMPLEMENTARIA
      </div>
    {% endif %}

  </div>

  <div class="card-content">

    <div class="activity-title-row">

      <h3>

        <a
          class="card-title-link"
          href="{{ activityUrl | url }}">

          {{ item.title | smartTitle }}

          {% if item.version %}

            <div class="hero-version version-{{ item.version | lower }}">

              {% if item.version == "DRAFT" %}
                BORRADOR
              {% else %}
                {{ item.version }}
              {% endif %}

            </div>

          {% endif %}

        </a>

      </h3>

    </div>

    {% if item.summary %}

      <p>

        <a
          class="card-description-link"
          href="{{ activityUrl | url }}">

          {{ item.summary | truncate(90) }}

        </a>

      </p>

    {% endif %}

    <div class="activity-facts">

      {% if item.participants %}
        <span>
          <span class="material-symbols-outlined">groups</span>
          {{ item.participants }}
        </span>
      {% endif %}

      {% if item.duration %}
        <span>
          <span class="material-symbols-outlined">schedule</span>
          {{ item.duration }}
        </span>
      {% endif %}

      {% if item.age_group %}
        <span>
          <span class="material-symbols-outlined">cake</span>
          {{ item.age_group | ageRange }}
        </span>
      {% endif %}

    </div>



<div class="activity-meta-row activity-meta-row-1">

  <div class="activity-ages">

    {% if item.age_group %}

      {% for age in item.age_group %}

        {% set ageInfo = age | normalizeAge(ageGroups) %}

        {% if ageInfo and ageInfo.icon %}

          <a
            href="{{ ('/edades/' + ageInfo.id + '/') | url }}">

            <img
              class="branch-icon"
              src="{{ ('/imagenes/ramas/' + ageInfo.icon) | url }}"
              alt="{{ ageInfo.name }}"
              title="{{ ageInfo.name }}">

          </a>

        {% endif %}

      {% endfor %}

    {% endif %}

  </div>

  <div class="activity-files">

    {% if item.attachments and item.attachments.length %}

      <span class="material-symbols-outlined">
        attach_file
      </span>

    {% endif %}

  </div>

</div>



<div class="activity-meta-row activity-meta-row-2">

  <div class="activity-sdgs">

    {% if item.sdgs and item.sdgs.length %}

      {% for sdg in item.sdgs.slice(0,3) %}

        <a
          href="{{ ('/ods/' + sdg + '/') | url }}">

          <img
            class="sdg-icon"
            src="{{ ('/imagenes/ods/ods-' + sdg + '.png') | url }}"
            alt="ODS {{ sdg }}"
            title="ODS {{ sdg }}">

        </a>

      {% endfor %}

    {% endif %}

  </div>

  <div class="activity-badges">

    {% if item.activity_badges %}

      {% for rawBadge in item.activity_badges.slice(0,3) %}

        {% if rawBadge.id %}

          {% set badgeId = rawBadge.id %}
          {% set badgeName = rawBadge.name %}

        {% else %}

          {% set badgeId = rawBadge | slugify %}
          {% set badgeName = rawBadge | smartTitle %}

        {% endif %}

        {% set badgeData = badgeId | badgeInfo(badges) %}

        <a
          href="{{ ('/badges/' + badgeId + '/') | url }}">

          <img
            class="badge-icon"
            src="{{
              (
                badgeData.logo
                if badgeData and badgeData.logo
                else '/imagenes/insignias/' + badgeId + '.png'
              ) | url
            }}"
            alt="{{ badgeName }}"
            title="{{ badgeName }}">

        </a>

      {% endfor %}

    {% endif %}

  </div>

</div>

</div>

</div>

{% endmacro %}

