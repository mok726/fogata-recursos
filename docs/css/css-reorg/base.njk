<!DOCTYPE html>
<html lang="{{ site.language }}">

<head>

<meta
  name="generator"
  content="Eleventy">

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0">

  {% set pageTitle %}
    {% if title %}
      {{ title }} - {{ site.name }}
    {% else %}
      {{ site.name }}
    {% endif %}
  {% endset %}

  {% set pageDescription %}
    {% if description %}
      {{ description }}
    {% else %}
      {{ site.description }}
    {% endif %}
  {% endset %}

  {% set canonicalUrl %}
    {{ site.url }}{{ page.url | url }}
  {% endset %}

  <title>
    {{ pageTitle | trim }}
  </title>

  <meta
    name="description"
    content="{{ pageDescription | trim }}">

  <meta
    name="theme-color"
    content="#355b38">

  <meta
    name="author"
    content="{{ site.author }}">

  <link
    rel="canonical"
    href="{{ canonicalUrl | trim }}">

	<!-- Favicon -->
  <link
    rel="icon"
    type="image/png"
    href="{{ '/imagenes/favicon.png' | url }}"  sizes="780x1123">

  <link
    rel="icon"
    type="image/png"
    href="{{ '/imagenes/favicon-square.png' | url }}"  sizes="1123x1123">

  <link
    rel="icon"
    type="image/png"
    href="{{ '/imagenes/favicon-square-small.png' | url }}"  sizes="300x300">





  <!-- OpenGraph -->

  <meta
    property="og:type"
    content="website">

  <meta
    property="og:site_name"
    content="{{ site.name }}">

  <meta
    property="og:title"
    content="{{ pageTitle | trim }}">

  <meta
    property="og:description"
    content="{{ pageDescription | trim }}">

  <meta
    property="og:url"
    content="{{ canonicalUrl | trim }}">

<meta property='og:locale' content='es_AR' />

<!-- Image to display -->

<meta
  property="og:image"
  content="{{ site.url }}{{ site.pathPrefix }}/imagenes/social-preview.png">
<meta property="og:image:width" content="1731" />
<meta property="og:image:height" content="909" />
<meta property="og:image:alt" content="{{ pageTitle | trim }}" />

<meta
  property="og:image"
  content="{{ site.url }}{{ site.pathPrefix }}/imagenes/social-card-small.png">
<meta property="og:image:width" content="300" />
<meta property="og:image:height" content="158" />
<meta property="og:image:alt" content="{{ pageTitle | trim }}" />




 
<!-- No need to change anything here -->
<!-- meta property="og:image:type" content="image/jpeg" -->
  

<!-- MS, fb & Whatsapp -->

<!-- MS Tile - for Microsoft apps-->
<meta name="msapplication-TileImage" content="{{ site.url }}{{ site.pathPrefix }}/imagenes/social-card.png">    
<!-- meta name="msapplication-TileImage" content="{{ '/imagenes/favicon-square-270x270.png' | url }}" -->


<meta property="fb:admins" content="mscosentino"/>


  <link rel="apple-touch-icon-precomposed" href="{{ '/imagenes/favicon-square-180x180.png' | url }}">




<!--
put this inside the body 
<link itemprop="thumbnailUrl" href="url_image"> 
<span itemprop="thumbnail" itemscope itemtype="http://schema.org/ImageObject"> 
  <link itemprop="url" href="{{ site.url }}{{ site.pathPrefix }}/imagenes/social-card-small.png"> 
</span>
-->

<link itemprop="thumbnailUrl" href="{{ site.url }}{{ site.pathPrefix }}/imagenes/social-card-small.png"> 




  <!-- Twitter -->

  <meta
    name="twitter:card"
    content="summary_large_image">

  <meta
    name="twitter:title"
    content="{{ pageTitle | trim }}">

  <meta
    name="twitter:description"
    content="{{ pageDescription | trim }}">

<meta
  name="twitter:image"
  content="{{ site.url }}{{ site.pathPrefix }}/imagenes/social-preview.png">

<meta name="twitter:image:alt" content="{{ pageTitle | trim }}" />
<!-- meta name="twitter:site" content="@MCTArgentina" / -->
<meta name="twitter:creator" content="@mok726">






  <!-- Performance -->

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com">

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin>


<!-- Google Fonts (text) – keep if you use it -->
<link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,600;14..32,700&display=swap" rel="stylesheet">

<!-- Google Material Symbols (icons) – add this -->
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">





  <!-- CSS -->
  <!-- main.css ya hace @import de todo lo transversal
       (variables, base, layout, navbar, footer, chips,
       icons, components, cards, disclosure, responsive).
       Antes había 7 <link> más acá; 5 apuntaban a archivos
       que no existían (404 silencioso) y los otros 2 ya
       estaban duplicados dentro de main.css. -->
<link rel="stylesheet" href="{{ '/css/main.css' | url }}">



{% if styles %}
  {% for css in styles %}
<link rel="stylesheet" href="{{ css | url }}">
  {% endfor %}
{% endif %}




</head>

<body>

  {% include "components/navbar.njk" %}

  <main class="page-container">

    {{ content | safe }}

  </main>

  {% include "components/footer.njk" %}

  <script
    src="{{ '/pagefind/pagefind-ui.js' | url }}">
  </script>


<span itemprop="thumbnail" itemscope itemtype="http://schema.org/ImageObject"> 
  <link itemprop="url" href="{{ site.url }}{{ site.pathPrefix }}/imagenes/social-card-small.png"> 
</span>




</body>

</html>
